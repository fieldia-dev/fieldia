{
  "name": "@fieldia/testing",
  "version": "0.33.0",
  "description": "Test the Fieldia forms in your app as people use them: fill, pick, check and press by the words people read, a field's errors and value read back — for Testing Library and Playwright — and fieldia-check, which keeps stored pages valid in CI.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "bin": {
    "fieldia-check": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.d.mts",
        "require": "./src/index.d.ts"
      },
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./playwright": {
      "types": {
        "import": "./src/playwright.d.mts",
        "require": "./src/playwright.d.ts"
      },
      "import": "./src/playwright.mjs",
      "require": "./src/playwright.js",
      "default": "./src/playwright.js"
    },
    "./pages": {
      "types": {
        "import": "./src/pages.d.mts",
        "require": "./src/pages.d.ts"
      },
      "import": "./src/pages.mjs",
      "require": "./src/pages.js",
      "default": "./src/pages.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fieldia/core": "0.33.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "sideEffects": [
    "./src/cli.*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/testing"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
