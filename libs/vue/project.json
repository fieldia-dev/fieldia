{
  "name": "vue",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/vue/src",
  "projectType": "library",
  "tags": [
    "scope:fieldia",
    "type:binding"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "compile-cjs",
        "compile-esm"
      ],
      "outputs": [
        "{workspaceRoot}/dist/libs/vue"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "options": {
        "command": "node tools/dual-build.mjs vue"
      }
    },
    "compile-cjs": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/vue",
        "main": "libs/vue/src/index.ts",
        "tsConfig": "libs/vue/tsconfig.lib.json",
        "assets": [
          "libs/vue/*.md",
          "libs/vue/LICENSE"
        ]
      }
    },
    "compile-esm": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "tmp/vue/esm",
        "main": "libs/vue/src/index.ts",
        "tsConfig": "libs/vue/tsconfig.lib.esm.json",
        "generatePackageJson": false,
        "assets": [
          "libs/vue/package.json"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/vue/jest.config.cjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/vue/tsconfig.lib.json --noEmit",
          "tsc -p libs/vue/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/vue"
      }
    }
  }
}
