{
  "name": "@fieldia/designer",
  "version": "0.13.0",
  "description": "Build Fieldia pages without writing JSON: an editing model with undo and versions, a survey editor, and a canvas.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.d.mts",
        "require": "./src/index.d.ts"
      },
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": {
        "import": "./src/react.d.mts",
        "require": "./src/react.d.ts"
      },
      "import": "./src/react.mjs",
      "require": "./src/react.js",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": {
        "import": "./src/vue.d.mts",
        "require": "./src/vue.d.ts"
      },
      "import": "./src/vue.mjs",
      "require": "./src/vue.js",
      "default": "./src/vue.js"
    },
    "./angular": {
      "types": "./angular/index.d.mts",
      "import": "./angular/index.mjs",
      "default": "./angular/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fieldia/core": "0.13.0",
    "@fieldia/viewer": "0.13.0",
    "@fieldia/widgets": "0.13.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.4.0",
    "@angular/core": "^21.0.0 || ^22.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/designer"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "angular"
  ]
}
