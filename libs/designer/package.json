{
  "name": "@fieldia/designer",
  "version": "0.0.0",
  "description": "Build Fieldia pages without writing JSON: an editing model with undo and versions, a survey editor, and a canvas.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.d.mts",
        "require": "./src/index.d.ts"
      },
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fieldia/core": "0.0.0",
    "@fieldia/viewer": "0.0.0",
    "@fieldia/widgets": "0.0.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@grafloria/element": ">=0.4.83"
  },
  "peerDependenciesMeta": {
    "@grafloria/element": {
      "optional": true
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/designer"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
