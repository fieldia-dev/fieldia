{
  "name": "@fieldia/code",
  "version": "0.6.0",
  "description": "Fieldia's JSON fields in a code editor: CodeMirror 6, bundled, so it works offline.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.d.mts",
        "require": "./src/index.d.ts"
      },
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fieldia/core": "0.6.0",
    "@fieldia/widgets": "0.6.0",
    "tslib": "^2.8.1"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/code"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
