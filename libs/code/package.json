{
  "name": "@fieldia/code",
  "version": "0.16.0",
  "description": "Fieldia fields in a code editor: JSON, and text in 44 languages from Python to SQL. CodeMirror 6, each grammar loaded only when a field uses it.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.d.mts",
        "require": "./src/index.d.ts"
      },
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": ">=6.12.4 <6.13.0 || >=6.13.1 <7.0.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fieldia/core": "0.16.0",
    "@fieldia/widgets": "0.16.0",
    "@lezer/highlight": "^1.2.5",
    "tslib": "^2.8.1"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/code"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
