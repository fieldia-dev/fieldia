{
  "name": "code",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/code/src",
  "projectType": "library",
  "tags": [
    "scope:fieldia",
    "type:code"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "compile-cjs",
        "compile-esm"
      ],
      "outputs": [
        "{workspaceRoot}/dist/libs/code"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "options": {
        "command": "node tools/dual-build.mjs code"
      }
    },
    "compile-cjs": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/code",
        "main": "libs/code/src/index.ts",
        "tsConfig": "libs/code/tsconfig.lib.json",
        "assets": [
          "libs/code/*.md",
          "libs/code/LICENSE"
        ]
      }
    },
    "compile-esm": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "tmp/code/esm",
        "main": "libs/code/src/index.ts",
        "tsConfig": "libs/code/tsconfig.lib.esm.json",
        "generatePackageJson": false,
        "assets": [
          "libs/code/package.json"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/code/jest.config.cjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/code/tsconfig.lib.json --noEmit",
          "tsc -p libs/code/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/code"
      }
    }
  }
}
