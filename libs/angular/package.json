{
  "name": "@fieldia/angular",
  "version": "0.3.0",
  "description": "Angular binding for Fieldia: <fieldia-form> over the plain-DOM viewer, with custom fields as Angular components and slots as ng-templates.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "module",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fieldia/core": "0.3.0",
    "@fieldia/viewer": "0.3.0",
    "@fieldia/widgets": "0.3.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0 || ^22.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/angular"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
