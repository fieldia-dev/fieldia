{
  "name": "@fieldia/viewer",
  "version": "0.25.0",
  "description": "Mount a Fieldia page in any web page: plain DOM, no framework.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "unpkg": "./bundle/fieldia.js",
  "jsdelivr": "./bundle/fieldia.js",
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.d.mts",
        "require": "./src/index.d.ts"
      },
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./bundle/fieldia.js": "./bundle/fieldia.js",
    "./bundle/fieldia.ar.js": "./bundle/fieldia.ar.js",
    "./bundle/fieldia.de.js": "./bundle/fieldia.de.js",
    "./bundle/fieldia.fr.js": "./bundle/fieldia.fr.js",
    "./bundle/fieldia.filters.js": "./bundle/fieldia.filters.js",
    "./bundle/fieldia.files.js": "./bundle/fieldia.files.js",
    "./bundle/fieldia.head.js": "./bundle/fieldia.head.js",
    "./bundle/fieldia.list.js": "./bundle/fieldia.list.js",
    "./bundle/fieldia.path.js": "./bundle/fieldia.path.js",
    "./bundle/fieldia.text.js": "./bundle/fieldia.text.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fieldia/core": "0.25.0",
    "@fieldia/widgets": "0.25.0",
    "tslib": "^2.8.1"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/viewer"
  },
  "files": [
    "src",
    "bundle",
    "README.md",
    "LICENSE"
  ]
}
