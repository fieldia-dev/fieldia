{
  "name": "@fieldia/map",
  "version": "0.19.0",
  "description": "Fieldia's maps: a place and an area as fields, and a list's records on a map, on any map provider. Leaflet, loaded only where a map is shown.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.d.mts",
        "require": "./src/index.d.ts"
      },
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fieldia/core": "0.19.0",
    "@fieldia/viewer": "0.19.0",
    "@fieldia/widgets": "0.19.0",
    "leaflet": "^1.9.4",
    "tslib": "^2.8.1"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/map"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
