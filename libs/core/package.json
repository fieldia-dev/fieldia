{
  "name": "@fieldia/core",
  "version": "0.2.0",
  "description": "Headless form model for Fieldia: the page format, modifiers, validation and record state. No DOM.",
  "license": "MIT",
  "homepage": "https://fieldia.dev",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.d.mts",
        "require": "./src/index.d.ts"
      },
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./page.schema.json": "./schema/page.schema.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldia-dev/fieldia",
    "directory": "libs/core"
  },
  "files": [
    "src",
    "schema",
    "README.md",
    "LICENSE"
  ]
}
