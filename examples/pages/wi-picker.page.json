{
  "fieldia": "0.1",
  "id": "wi-picker",
  "title": "Bug 4127",
  "description": "The pickers of a work item: Area and Iteration as paths with suggestions and a tree, State in its own list, Planning's choices in Fieldia's own list, tags added from a button, and no one assigned yet.",
  "data": { "kind": "record", "model": "wi.picker" },
  "look": { "theme": "fluent", "skin": "quiet", "density": "compact" },
  "fields": {
    "assigned_to": { "type": "many2one", "label": "Assigned To", "relation": "wi.user" },
    "tags": { "type": "many2many", "label": "Tags", "relation": "wi.tag" },
    "state": {
      "type": "selection",
      "label": "State",
      "required": true,
      "options": [
        { "value": "new", "label": "New" },
        { "value": "active", "label": "Active" },
        { "value": "resolved", "label": "Resolved" },
        { "value": "closed", "label": "Closed" }
      ]
    },
    "reason": {
      "type": "selection",
      "label": "Reason",
      "options": [
        { "value": "new", "label": "New" },
        { "value": "approved", "label": "Approved" },
        { "value": "investigated", "label": "Investigation Complete" },
        { "value": "fixed", "label": "Fixed" }
      ]
    },
    "area": { "type": "many2one", "label": "Area", "relation": "wi.area", "required": true },
    "iteration": { "type": "many2one", "label": "Iteration", "relation": "wi.iteration", "required": true },
    "category": {
      "type": "selection",
      "label": "Category",
      "options": [
        { "value": "business", "label": "Business" },
        { "value": "architectural", "label": "Architectural" }
      ]
    },
    "story_points": { "type": "float", "label": "Story Points" },
    "priority": {
      "type": "selection",
      "label": "Priority",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    "severity": {
      "type": "selection",
      "label": "Severity",
      "options": [
        { "value": "1", "label": "1 - Critical" },
        { "value": "2", "label": "2 - High" },
        { "value": "3", "label": "3 - Medium" },
        { "value": "4", "label": "4 - Low" }
      ]
    },
    "activity": {
      "type": "selection",
      "label": "Activity",
      "options": [
        { "value": "deployment", "label": "Deployment" },
        { "value": "design", "label": "Design" },
        { "value": "development", "label": "Development" },
        { "value": "documentation", "label": "Documentation" },
        { "value": "requirements", "label": "Requirements" },
        { "value": "testing", "label": "Testing" }
      ]
    }
  },
  "layout": {
    "type": "sections",
    "id": "root",
    "children": [
      {
        "type": "section",
        "id": "meta",
        "style": "plain",
        "columns": 2,
        "children": [
          { "type": "field", "id": "f-assigned", "field": "assigned_to", "labels": "hidden", "placeholder": "No one selected", "options": { "avatar": true } },
          { "type": "field", "id": "f-tags", "field": "tags", "labels": "hidden", "placeholder": "Add Tag", "options": { "adder": "button" } }
        ]
      },
      {
        "type": "section",
        "id": "band",
        "style": "plain",
        "labels": "beside",
        "labelWidth": 76,
        "columns": { "wide": 2, "narrow": 1 },
        "children": [
          {
            "type": "field",
            "id": "f-state",
            "field": "state",
            "widget": "dot",
            "options": { "label": true, "listDots": false, "colours": { "new": "#b2b2b2", "active": "#007acc", "resolved": "#ff9d00", "closed": "#339933" } }
          },
          { "type": "field", "id": "f-area", "field": "area", "widget": "path" },
          { "type": "field", "id": "f-reason", "field": "reason", "readonly": true, "readonlyReason": "Set by the workflow when the State changes" },
          { "type": "field", "id": "f-iteration", "field": "iteration", "widget": "path" }
        ]
      },
      {
        "type": "section",
        "id": "planning",
        "title": "Planning",
        "style": "line",
        "children": [
          { "type": "field", "id": "f-category", "field": "category", "options": { "list": "own" } },
          { "type": "field", "id": "f-points", "field": "story_points" },
          { "type": "field", "id": "f-priority", "field": "priority", "options": { "list": "own" } },
          { "type": "field", "id": "f-severity", "field": "severity", "options": { "list": "own" } },
          { "type": "field", "id": "f-activity", "field": "activity", "options": { "list": "own" } }
        ]
      }
    ]
  },
