{
  "fieldia": "0.1",
  "id": "real-crm-lead-lost",
  "title": "Lost Lead",
  "data": { "kind": "responses" },
  "maxWidth": "medium",
  "fields": {
    "lost_reason_id": { "type": "many2one", "label": "Lost Reason", "relation": "crm.lost.reason" },
    "lost_feedback": { "type": "html", "label": "Closing Note" }
  },
  "layout": {
    "type": "sections",
    "id": "lost",
    "children": [
      {
        "type": "section",
        "id": "lost-reason",
        "style": "plain",
        "children": [
          { "type": "field", "id": "f-lost-reason", "field": "lost_reason_id", "options": { "create": false } },
          { "type": "field", "id": "f-lost-feedback", "field": "lost_feedback", "placeholder": "What went wrong?" }
        ]
      }
    ],
    "footer": [
      {
        "type": "button",
        "id": "action_lost_reason_apply",
        "label": "Mark as Lost",
        "style": "primary",
        "hotkey": "q",
        "steps": [
          { "do": "check" },
          { "do": "post", "message": "Lost: {lost_reason_id}. {lost_feedback}", "when": "lost_feedback" },
          { "do": "post", "message": "Lost: {lost_reason_id}.", "when": "not lost_feedback" },
          { "do": "save" }
        ]
      },
      { "type": "button", "id": "cancel", "label": "Cancel", "hotkey": "x", "steps": [{ "do": "close" }] }
    ]
  }
}
