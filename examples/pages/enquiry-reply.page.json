        "title": "Your reply",
        "children": [
          {
            "type": "field",
            "id": "f-reply",
            "field": "reply",
            "labels": "hidden",
            "placeholder": "Write your reply, or press Draft",
            "options": {
              "rewrite": [
                "draft",
                "polish"
              ]
            }
          }
        ]
      }
    ]
  },
  "suggest": {
