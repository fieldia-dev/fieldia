      "field": "state"
    },
    "children": [
      {
        "type": "section",
        "id": "buyer",
        "columns": 3,
        "children": [
          {
            "type": "field",
            "id": "f-partner",
            "field": "partner_name"
          },
          {
            "type": "field",
