{
  "fieldia": "0.7",
  "id": "homes-gallery",
  "title": "Homes for sale",
  "description": "Homes for sale and to rent as a gallery: each a card with its photo large, its price leading, where it is and how big, its offer as a pill and a button to book a viewing — a list on a switcher's press, cards in one column on a phone.",
  "data": { "kind": "record", "model": "home" },
  "records": { "one": "property", "other": "properties", "a": "a property" },
  "fields": {
    "name": { "type": "char", "label": "Home" },
    "kind": {
      "type": "selection",
      "label": "Type",
      "options": [
        { "value": "flat", "label": "Flat" },
        { "value": "duplex", "label": "Duplex" },
        { "value": "penthouse", "label": "Penthouse" },
        { "value": "villa", "label": "Villa" }
      ]
    },
    "offer": {
      "type": "selection",
      "label": "Offer",
      "options": [
        { "value": "sale", "label": "For sale" },
        { "value": "rent", "label": "For rent" }
      ]
    },
    "price": {
      "type": "monetary",
      "label": "Price",
      "currencyField": "currency",
      "digits": [12, 0],
      "money": { "currency": "code", "at": "after", "per": [{ "period": "month", "when": "offer == 'rent'" }] }
    },
    "currency": { "type": "char", "label": "Currency" },
    "bedrooms": { "type": "integer", "label": "Bedrooms" },
    "area_m2": { "type": "integer", "label": "Area, m²" },
    "district": {
      "type": "selection",
      "label": "District",
      "options": [
        { "value": "zamalek", "label": "Zamalek" },
        { "value": "garden_city", "label": "Garden City" },
        { "value": "dokki", "label": "Dokki" },
        { "value": "mohandessin", "label": "Mohandessin" },
        { "value": "maadi", "label": "Maadi" },
        { "value": "heliopolis", "label": "Heliopolis" },
        { "value": "nasr_city", "label": "Nasr City" },
        { "value": "new_cairo", "label": "New Cairo" },
        { "value": "sheikh_zayed", "label": "Sheikh Zayed" },
        { "value": "october", "label": "6th of October" }
      ]
    },
    "photo": { "type": "image", "label": "Photo" },
    "listed_on": { "type": "date", "label": "Listed on" }
  },
  "layout": {
    "type": "list",
    "id": "homes-gallery",
    "columns": ["photo", "name", "offer", "price", "bedrooms", "area_m2", "district", "listed_on"],
    "sort": [{ "field": "listed_on", "desc": true }],
    "pageSize": 12,
    "searchFields": ["name", "district"],
    "filters": [
      { "id": "sale", "label": "For sale", "filter": [{ "field": "offer", "op": "=", "value": "sale" }] },
      { "id": "rent", "label": "For rent", "filter": [{ "field": "offer", "op": "=", "value": "rent" }] },
      { "id": "family", "label": "Three bedrooms or more", "filter": [{ "field": "bedrooms", "op": ">=", "value": 3 }] }
    ],
    "groupBy": ["district", "kind", "offer"],
    "cells": {
      "photo": { "widget": "image" },
      "offer": { "widget": "badge", "options": { "tones": { "sale": "success", "rent": "info" } } }
    },
    "card": {
      "title": "name",
      "image": "photo",
      "status": "offer",
      "labels": false,
      "lead": true,
      "fields": [
        "price",
        ["district", { "field": "bedrooms", "unit": { "one": "bedroom", "other": "bedrooms" } }, { "field": "area_m2", "unit": "m²" }]
      ]
    },
    "gallery": { "opens": "gallery" },
    "rowButtons": [{ "type": "button", "id": "book-viewing", "label": "Book a viewing", "icon": "calendar", "action": "book_viewing" }],
    "actions": [{ "type": "button", "id": "share-homes", "label": "Share with a buyer", "action": "share_homes" }]
  },
  "translations": {
    "ar": {
      "Homes for sale": "منازل للبيع",
      "property": "عقار",
      "properties": "عقارات",
      "a property": "عقار",
      "Home": "المنزل",
      "Type": "النوع",
      "Flat": "شقة",
      "Duplex": "دوبلكس",
      "Penthouse": "بنتهاوس",
      "Villa": "فيلا",
      "Offer": "العرض",
      "For sale": "للبيع",
      "For rent": "للإيجار",
      "Price": "السعر",
      "Currency": "العملة",
      "Bedrooms": "غرف النوم",
      "Area, m²": "المساحة، م²",
      "District": "الحي",
      "Zamalek": "الزمالك",
      "Garden City": "جاردن سيتي",
      "Dokki": "الدقي",
      "Mohandessin": "المهندسين",
      "Maadi": "المعادي",
      "Heliopolis": "مصر الجديدة",
      "Nasr City": "مدينة نصر",
      "New Cairo": "القاهرة الجديدة",
      "Sheikh Zayed": "الشيخ زايد",
      "6th of October": "السادس من أكتوبر",
      "Photo": "الصورة",
      "Listed on": "تاريخ الإدراج",
      "Three bedrooms or more": "ثلاث غرف نوم أو أكثر",
      "Book a viewing": "احجز معاينة",
      "Share with a buyer": "شارك مع مشترٍ",
      "bedroom": "غرفة نوم",
      "bedrooms": "غرف نوم",
      "m²": "م²"
    }
  }
}
