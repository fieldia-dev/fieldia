  "layout": {
    "type": "list",
    "id": "orders",
    "columns": [
      "name",
      "customer",
      "district",
      "total",
      "status"
    ],
    "sort": [
      {
        "field": "name"
      }
    ],
    "pageSize": 20,
    "searchFields": [
      "name",
      "customer",
      "district",
      "status"
    ],
    "filters": [
      {
        "id": "big",
        "label": "Over EGP 800",
        "filter": [
          {
            "field": "total",
            "op": ">",
            "value": 800
          }
        ]
      }
    ],
    "map": {
      "point": "place",
      "pin": {
        "look": "label",
        "label": "total"
      },
      "card": {
        "title": "name",
        "fields": [
          "customer",
          "district",
          "total"
        ]
      },
      "heat": {
        "weight": "total"
      },
