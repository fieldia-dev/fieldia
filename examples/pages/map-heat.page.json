          "label": "Dokki"
        },
        {
          "value": "mohandessin",
          "label": "Mohandessin"
        },
        {
          "value": "imbaba",
          "label": "Imbaba"
        },
        {
          "value": "shubra",
          "label": "Shubra"
        },
        {
          "value": "abbasia",
          "label": "Abbasia"
        },
        {
          "value": "heliopolis",
          "label": "Heliopolis"
        },
        {
          "value": "nasr_city",
          "label": "Nasr City"
