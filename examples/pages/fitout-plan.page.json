      "To do": "لم تبدأ",
      "Under way": "جارية",
      "Done": "تمت",
      "Not done": "لم تتم",
      "Electrics": "الكهرباء",
      "task": "مهمة",
      "tasks": "مهام",
      "a task": "مهمة"
    }
  }
}
