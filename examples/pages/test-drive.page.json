{
  "fieldia": "0.2",
  "id": "test-drive",
  "title": "Book a test drive",
  "description": "At the Berlin showroom: its times are on Berlin's clock, wherever you book from.",
  "timeZone": "Europe/Berlin",
  "data": { "kind": "record", "model": "drive.booking" },
  "fields": {
    "customer": { "type": "char", "label": "Name", "required": true },
    "phone": { "type": "char", "label": "Phone" },
    "email": { "type": "char", "label": "Email", "pattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+" },
    "car": { "type": "many2one", "label": "Car", "relation": "showroom.car", "required": true },
    "start": { "type": "datetime", "label": "Test drive", "required": true, "min": "today" },
    "stop": { "type": "datetime", "label": "Back by", "readonly": true },
    "licence": { "type": "boolean", "label": "Driving licence seen" },
    "call_back": { "type": "datetime", "label": "Call back at" },
    "notes": { "type": "text", "label": "Notes" }
  },
  "layout": {
    "type": "sections",
    "id": "drive",
    "children": [
      {
        "type": "section",
        "id": "who",
        "title": "Who drives",
        "columns": 3,
        "children": [
          { "type": "field", "id": "f-customer", "field": "customer", "focus": true },
          { "type": "field", "id": "f-phone", "field": "phone", "widget": "phone" },
          { "type": "field", "id": "f-email", "field": "email", "widget": "email" }
        ]
      },
      {
        "type": "section",
        "id": "when",
        "title": "Car and time",
        "children": [
          { "type": "field", "id": "f-car", "field": "car", "help": "Each car has its own times." },
          {
            "type": "field",
            "id": "f-start",
            "field": "start",
            "widget": "slots",
            "options": { "schedule": "showroom", "endField": "stop", "dependsOn": ["car"] }
          },
          { "type": "field", "id": "f-stop", "field": "stop" }
        ]
      },
      {
        "type": "section",
        "id": "before",
        "title": "Before the drive",
        "columns": 2,
        "children": [
          { "type": "field", "id": "f-licence", "field": "licence" },
          { "type": "field", "id": "f-call-back", "field": "call_back", "help": "On Berlin's clock, as every time here." },
          { "type": "field", "id": "f-notes", "field": "notes", "colspan": 2 }
        ]
      }
    ]
  },
  "translations": {
