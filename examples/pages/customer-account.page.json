{
  "fieldia": "0.3",
  "id": "customer-account",
  "title": "A customer’s account",
  "description": "A customer with the invoices and quotations that point at it, listed inside the record.",
  "data": {
    "kind": "record",
    "model": "partner"
  },
  "fields": {
    "name": {
      "type": "char",
      "label": "Customer",
      "required": true
    },
    "email": {
      "type": "char",
      "label": "Email"
    },
    "phone": {
      "type": "char",
      "label": "Phone"
    },
    "country_id": {
      "type": "many2one",
      "label": "Country",
      "relation": "country"
    },
    "credit_limit": {
      "type": "monetary",
      "label": "Credit limit",
      "currencyField": "currency_id"
    },
    "currency_id": {
      "type": "many2one",
      "label": "Currency",
      "relation": "currency"
    },
    "notes": {
      "type": "text",
      "label": "Notes"
    }
  },
  "layout": {
    "type": "sheet",
    "id": "sheet",
    "title": {
      "field": "name",
      "placeholder": "Customer’s name"
    },
    "children": [
      {
        "type": "section",
        "id": "account",
        "columns": 2,
        "children": [
          {
            "type": "field",
            "id": "f-email",
            "field": "email"
          },
          {
            "type": "field",
            "id": "f-phone",
            "field": "phone"
          },
          {
            "type": "field",
            "id": "f-country",
            "field": "country_id"
          },
          {
            "type": "field",
            "id": "f-credit",
            "field": "credit_limit"
          }
        ]
      },
      {
        "type": "related",
        "id": "invoices",
        "title": "Invoices",
        "model": "invoice",
        "field": "partner_id",
        "fields": {
          "name": {
            "type": "char",
            "label": "Number"
          },
          "invoice_date": {
            "type": "date",
            "label": "Invoice date"
          },
          "due_date": {
            "type": "date",
            "label": "Due date"
          },
          "state": {
            "type": "selection",
            "label": "Status",
            "options": [
              {
                "value": "draft",
                "label": "Draft"
              },
              {
                "value": "sent",
                "label": "Sent"
              },
              {
                "value": "paid",
                "label": "Paid"
              }
            ]
          },
          "currency_id": {
            "type": "many2one",
            "label": "Currency",
            "relation": "currency"
          },
          "amount": {
            "type": "monetary",
            "label": "Amount",
            "currencyField": "currency_id",
            "money": {
              "currency": "code"
            }
          },
          "partner_id": {
            "type": "many2one",
            "label": "Customer",
            "relation": "partner"
          }
        },
        "columns": [
          "name",
          "invoice_date",
          "due_date",
          "state",
          "amount"
        ],
        "cells": {
          "state": {
            "widget": "dot",
            "options": {
              "tones": {
                "draft": "muted",
                "sent": "info",
                "paid": "success"
              }
            }
          },
          "amount": {
            "total": "sum"
          }
        },
        "card": { "title": "name", "status": "state", "lead": true, "fields": ["amount", "invoice_date", "due_date"] },
        "rowTones": [{ "tone": "danger", "when": "state == 'sent' and due_date < today()" }],
        "rowBold": "state == 'draft'",
        "rowButtons": [{ "type": "button", "id": "invoice-remind", "label": "Send a reminder", "icon": "mail", "action": "send_reminder", "invisible": "state != 'sent'" }],
        "sort": [
          {
            "field": "invoice_date",
            "desc": true
          },
          {
            "field": "name",
            "desc": true
          }
        ],
        "limit": 5,
        "searchFields": [
          "name",
          "state"
        ],
        "viewAll": {
          "page": "invoices"
        }
      },
      {
        "type": "tabs",
        "id": "more",
        "children": [
          {
            "type": "tab",
            "id": "tab-quotations",
            "label": "Quotations",
            "children": [
              {
                "type": "related",
                "id": "quotations",
                "model": "quotation",
                "field": "partner_id",
                "fields": {
                  "name": {
                    "type": "char",
                    "label": "Number"
                  },
                  "date": {
                    "type": "date",
                    "label": "Date"
                  },
                  "valid_until": {
                    "type": "date",
                    "label": "Valid until"
                  },
                  "state": {
                    "type": "selection",
                    "label": "Status",
                    "options": [
                      {
                        "value": "draft",
                        "label": "Draft"
                      },
                      {
                        "value": "sent",
                        "label": "Sent"
                      },
                      {
                        "value": "won",
                        "label": "Won"
                      },
                      {
                        "value": "lost",
                        "label": "Lost"
                      }
                    ]
                  },
                  "currency_id": {
                    "type": "many2one",
                    "label": "Currency",
                    "relation": "currency"
                  },
                  "amount": {
                    "type": "monetary",
                    "label": "Total",
                    "currencyField": "currency_id",
                    "money": {
                      "currency": "code"
                    }
                  },
                  "partner_id": {
                    "type": "many2one",
                    "label": "Customer",
                    "relation": "partner"
                  }
                },
                "columns": [
                  "name",
                  "date",
                  "valid_until",
                  "state",
                  "amount"
                ],
                "cells": {
                  "state": {
                    "widget": "dot",
                    "options": {
                      "tones": {
                        "draft": "muted",
                        "sent": "info",
                        "won": "success",
                        "lost": "danger"
                      }
                    }
                  }
                },
                "filter": [
                  {
                    "field": "state",
                    "op": "!=",
                    "value": "lost"
                  }
                ],
                "card": { "title": "name", "status": "state", "lead": true, "fields": ["amount", "date", "valid_until"] },
                "sort": [
                  {
                    "field": "date",
                    "desc": true
                  }
                ],
                "limit": 5,
                "searchFields": [
                  "name",
                  "state"
                ]
              }
            ]
          },
          {
            "type": "tab",
            "id": "tab-notes",
            "label": "Notes",
            "children": [
              {
                "type": "field",
                "id": "f-notes",
                "field": "notes"
              }
            ]
          }
        ]
      }
    ]
  }
}
