{
  "fieldia": "0.7",
  "id": "map-homes",
  "title": "Homes in Cairo",
  "description": "Homes for sale and to rent, as a list and on a map: each price on its pin, short, rentals in blue and by the month, a card for each with its picture and a link to its page.",
  "data": { "kind": "record", "model": "home" },
  "fields": {
    "name": { "type": "char", "label": "Home" },
    "kind": {
      "type": "selection",
      "label": "Type",
      "options": [
        { "value": "flat", "label": "Flat" },
        { "value": "duplex", "label": "Duplex" },
        { "value": "penthouse", "label": "Penthouse" },
        { "value": "villa", "label": "Villa" }
      ]
    },
    "offer": {
      "type": "selection",
      "label": "Offer",
      "options": [
        { "value": "sale", "label": "For sale" },
        { "value": "rent", "label": "For rent" }
      ]
    },
    "price": {
      "type": "monetary",
      "label": "Price",
      "currencyField": "currency",
      "digits": [12, 0],
      "money": { "currency": "code", "at": "after", "per": [{ "period": "month", "when": "offer == 'rent'" }] }
    },
    "currency": { "type": "char", "label": "Currency" },
    "bedrooms": { "type": "integer", "label": "Bedrooms" },
    "area_m2": { "type": "integer", "label": "Area, m²" },
    "district": {
      "type": "selection",
      "label": "District",
      "options": [
        { "value": "zamalek", "label": "Zamalek" },
        { "value": "garden_city", "label": "Garden City" },
        { "value": "dokki", "label": "Dokki" },
        { "value": "mohandessin", "label": "Mohandessin" },
        { "value": "maadi", "label": "Maadi" },
        { "value": "heliopolis", "label": "Heliopolis" },
        { "value": "nasr_city", "label": "Nasr City" },
        { "value": "new_cairo", "label": "New Cairo" },
        { "value": "sheikh_zayed", "label": "Sheikh Zayed" },
        { "value": "october", "label": "6th of October" }
      ]
    },
    "lat": { "type": "float", "label": "Latitude" },
    "lng": { "type": "float", "label": "Longitude" },
    "photo": { "type": "image", "label": "Photo" },
    "link": { "type": "char", "label": "Link" },
    "listed_on": { "type": "date", "label": "Listed on" }
  },
  "layout": {
    "type": "list",
    "id": "homes",
    "columns": ["name", "offer", "price", "bedrooms"],
    "sort": [{ "field": "listed_on", "desc": true }],
    "pageSize": 12,
    "searchFields": ["name", "district", "kind", "offer"],
    "card": { "title": "name", "image": "photo", "status": "offer", "lead": true, "labels": false, "fields": ["price", ["district", { "field": "bedrooms", "unit": { "one": "bedroom", "other": "bedrooms" } }]] },
    "filters": [
      { "id": "sale", "label": "For sale", "filter": [{ "field": "offer", "op": "=", "value": "sale" }] },
      { "id": "rent", "label": "For rent", "filter": [{ "field": "offer", "op": "=", "value": "rent" }] },
      { "id": "family", "label": "Three bedrooms or more", "filter": [{ "field": "bedrooms", "op": ">=", "value": 3 }] }
    ],
    "groupBy": ["district", "kind", "offer"],
    "actions": [{ "type": "button", "id": "shortlist", "label": "Add to shortlist", "action": "shortlist" }],
    "map": {
      "latitude": "lat",
      "longitude": "lng",
      "pin": {
        "label": "price",
        "money": { "home": "EGP", "currency": "symbol", "at": "before" },
        "tones": [{ "tone": "info", "when": "offer == 'rent'" }]
      },
      "card": {
        "title": "name",
        "image": "photo",
        "href": "link",
        "labels": false,
        "lead": true,
        "fields": [
          "price",
          ["district", { "field": "bedrooms", "unit": { "one": "bedroom", "other": "bedrooms" } }, { "field": "area_m2", "unit": "m²" }]
        ]
      },
      "view": "both"
    }
  },
  "translations": {
    "ar": {
      "Homes in Cairo": "منازل في القاهرة",
      "Homes for sale and to rent, as a list and on a map: each price on its pin, short, rentals in blue and by the month, a card for each with its picture and a link to its page.": "منازل للبيع وللإيجار، في قائمة وعلى خريطة: سعر كل منزل مختصرًا على دبوسه، والإيجار بالأزرق وبالشهر، ولكل منزل بطاقة بصورته ورابط إلى صفحته.",
      "Home": "المنزل",
      "Type": "النوع",
      "Flat": "شقة",
      "Duplex": "دوبلكس",
      "Penthouse": "بنتهاوس",
      "Villa": "فيلا",
      "Offer": "العرض",
      "For sale": "للبيع",
      "Price": "السعر",
      "Currency": "العملة",
      "Link": "الرابط",
      "bedroom": "غرفة نوم",
      "bedrooms": "غرف نوم",
      "m²": "م²",
      "Bedrooms": "غرف النوم",
      "Area, m²": "المساحة، م²",
      "District": "الحي",
      "Zamalek": "الزمالك",
