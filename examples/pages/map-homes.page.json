      "Latitude": "خط العرض",
      "Longitude": "خط الطول",
      "Photo": "الصورة",
      "Listed on": "تاريخ العرض",
      "For rent": "للإيجار",
      "Three bedrooms or more": "ثلاث غرف نوم أو أكثر",
      "Add to shortlist": "أضف إلى القائمة المختصرة"
    }
  }
}
