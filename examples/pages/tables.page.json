{
  "fieldia": "0.1",
  "id": "tables",
  "title": "Work order",
  "description": "A table's own rules, the way an ERP's lists have them: values and lines in a tone while a condition holds, choices drawn as pills, and buttons on the lines.",
  "data": {
    "kind": "record",
    "model": "mrp.workorder.sheet"
  },
  "fields": {
    "name": {
      "type": "char",
      "label": "Reference",
      "required": true
    },
    "state": {
      "type": "selection",
      "label": "Status",
      "options": [
        {
          "value": "draft",
          "label": "Draft"
        },
        {
          "value": "progress",
          "label": "In progress"
        },
        {
          "value": "done",
          "label": "Done"
        }
      ],
      "default": "draft"
    },
    "code": {
      "type": "char",
      "label": "Code"
    },
    "workcenter_id": {
      "type": "many2one",
      "label": "Work centre",
      "relation": "mrp.workcenter"
    },
    "deadline": {
      "type": "date",
      "label": "Deadline"
    },
    "available": {
      "type": "float",
      "label": "Hours available"
    },
    "minimum": {
      "type": "float",
      "label": "Hours needed"
    },
    "compliance_ids": {
      "type": "many2many",
      "label": "Checks",
      "relation": "quality.check",
      "fields": {
        "name": {
          "type": "char",
          "label": "Check"
        },
        "state": {
          "type": "selection",
          "label": "Result",
          "options": [
            {
              "value": "todo",
              "label": "To do"
            },
            {
              "value": "pass",
              "label": "Passed"
            },
            {
              "value": "fail",
              "label": "Failed"
            }
          ]
        }
      }
    },
    "currency_id": {
      "type": "many2one",
      "label": "Currency",
      "relation": "res.currency"
    },
    "operation_ids": {
      "type": "one2many",
      "label": "Operations",
      "relation": "mrp.workorder",
      "sequenceField": "sequence",
      "lineKinds": {
        "field": "kind",
        "text": "name"
      },
      "fields": {
        "sequence": {
          "type": "integer",
          "label": "Sequence"
        },
        "kind": {
          "type": "selection",
          "label": "Line type",
          "options": [
            {
              "value": "section",
              "label": "Section"
            },
            {
              "value": "note",
              "label": "Note"
            }
          ]
        },
        "name": {
          "type": "char",
          "label": "Operation",
          "required": true
        },
        "planned": {
          "type": "float",
          "label": "Planned hours"
        },
        "spent": {
          "type": "float",
          "label": "Hours spent"
        },
        "cost": {
          "type": "monetary",
          "label": "Cost",
          "currencyField": "parent.currency_id"
        },
        "state": {
          "type": "selection",
          "label": "Status",
          "options": [
            {
              "value": "ready",
              "label": "Ready"
            },
            {
              "value": "progress",
              "label": "In progress"
            },
            {
              "value": "blocked",
              "label": "Blocked"
            },
            {
              "value": "done",
              "label": "Done"
            }
          ]
        },
        "operator": {
          "type": "char",
          "label": "Operator"
        }
      }
    },
    "payer_ids": {
      "type": "one2many",
      "label": "Cost split",
      "relation": "mrp.cost.split",
      "fields": {
        "payer": {
          "type": "char",
          "label": "Payer"
        },
        "share": {
          "type": "float",
          "label": "Share %"
        }
      }
    }
  },
  "layout": {
    "type": "sections",
    "id": "root",
    "children": [
      {
        "type": "section",
        "id": "s-head",
        "title": "Work order",
        "columns": 2,
        "children": [
          {
            "type": "field",
            "id": "f-name",
            "field": "name"
          },
          {
            "type": "field",
            "id": "f-state",
            "field": "state",
            "widget": "badge",
            "tones": [
              {
                "tone": "success",
                "when": "state == 'done'"
              },
              {
                "tone": "info",
                "when": "state == 'progress'"
              }
            ]
          },
          {
            "type": "field",
            "id": "f-code",
            "field": "code",
            "widget": "badge"
          },
          {
            "type": "field",
            "id": "f-workcenter",
            "field": "workcenter_id",
            "widget": "badge"
          },
          {
            "type": "field",
            "id": "f-deadline",
            "field": "deadline",
            "tones": [
              {
                "tone": "danger",
                "when": "deadline and deadline < today() and state != 'done'"
              }
            ]
          },
          {
            "type": "field",
            "id": "f-available",
            "field": "available",
            "tones": [
              {
                "tone": "danger",
                "when": "available < minimum"
              },
              {
                "tone": "success",
                "when": "available >= minimum"
              }
            ],
            "bold": "available < 0"
          },
          {
            "type": "field",
            "id": "f-minimum",
            "field": "minimum"
          }
        ]
      },
      {
        "type": "section",
        "id": "s-ops",
        "title": "Operations",
        "children": [
          {
            "type": "field",
            "id": "f-currency",
            "field": "currency_id",
            "colspan": 4,
            "hideOn": [
              "narrow"
            ]
          },
          {
            "type": "field",
            "id": "f-ops",
            "field": "operation_ids",
            "widget": "grid",
            "cards": "narrow",
            "columns": [
              "name",
              "planned",
              "spent",
              "cost",
              "state",
              "operator"
            ],
            "totals": [
              "planned",
              "spent",
              "cost"
            ],
            "options": {
              "copy": true
            },
            "cells": {
              "spent": {
                "tones": [
                  {
                    "tone": "danger",
                    "when": "spent > planned"
                  }
                ],
                "bold": "spent > planned"
              },
              "state": {
                "badge": true,
                "tones": [
                  {
                    "tone": "success",
                    "when": "state == 'done'"
                  },
                  {
                    "tone": "info",
                    "when": "state == 'progress'"
                  },
                  {
                    "tone": "danger",
                    "when": "state == 'blocked'"
                  }
                ]
              },
              "operator": {
                "invisible": "state == 'ready'",
                "hidden": "state == 'draft'"
              }
            },
            "rowTones": [
              {
                "tone": "muted",
                "when": "state == 'done'"
              }
            ],
            "rowButtons": [
              {
                "type": "button",
                "id": "op-start",
                "label": "Start",
                "icon": "clock",
                "invisible": "state != 'ready'",
                "action": "button_start"
              }
            ],
            "selectedButtons": [
              {
                "type": "button",
                "id": "ops-start",
                "label": "Start",
                "action": "button_start"
              },
              {
                "type": "button",
                "id": "ops-done",
                "label": "Mark done",
                "action": "button_finish",
                "confirm": "Mark the chosen operations done?"
              }
            ],
            "controlButtons": [
              {
                "type": "button",
                "id": "ops-catalog",
                "label": "Catalog",
                "icon": "list",
                "action": "action_add_from_catalog",
                "invisible": "state == 'done'"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "id": "s-checks",
        "title": "Quality checks",
        "children": [
          {
            "type": "field",
            "id": "f-checks",
            "field": "compliance_ids",
            "widget": "table",
            "columns": [
              "name",
              "state"
            ]
          }
        ]
      },
      {
        "type": "section",
        "id": "s-split",
        "title": "Cost split",
        "children": [
          {
            "type": "field",
            "id": "f-split",
            "field": "payer_ids",
            "cards": "narrow",
            "fit": "content",
            "validate": [
              {
                "distinct": "payer"
              }
            ],
            "options": {
              "copy": true
            }
          }
        ]
      }
    ]
  }
}
