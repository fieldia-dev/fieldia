{
  "fieldia": "0.7",
  "id": "work-item-bug",
  "title": "Bug",
  "data": { "kind": "record", "model": "work.item" },
  "look": { "theme": "fluent", "skin": "quiet", "density": "compact", "quietHints": false, "lockAt": "value", "readonlyShown": "text" },
  "fields": {
    "number": { "type": "integer", "label": "ID", "readonly": true },
    "work_type": {
      "type": "selection",
      "label": "Work Item Type",
      "options": [{ "value": "bug", "label": "Bug" }, { "value": "task", "label": "Task" }, { "value": "story", "label": "User Story" }]
    },
    "title": { "type": "char", "label": "Title", "required": true },
    "assigned_to": { "type": "many2one", "label": "Assigned To", "relation": "res.users" },
    "comment_count": { "type": "integer", "label": "Comments", "readonly": true },
    "tags": { "type": "many2many", "label": "Tags", "relation": "work.tag" },
    "state": {
      "type": "selection",
      "label": "State",
      "options": [
        { "value": "new", "label": "New" },
        { "value": "active", "label": "Active" },
        { "value": "resolved", "label": "Resolved" },
        { "value": "closed", "label": "Closed" }
      ]
    },
    "reason": {
      "type": "selection",
      "label": "Reason",
      "options": [
        { "value": "new", "label": "New" },
        { "value": "approved", "label": "Approved" },
        { "value": "investigated", "label": "Investigation Complete" },
        { "value": "fixed", "label": "Fixed" },
        { "value": "verified", "label": "Verified" }
      ]
    },
    "area": { "type": "many2one", "label": "Area", "relation": "work.area" },
    "iteration": { "type": "many2one", "label": "Iteration", "relation": "work.iteration" },
    "repro_steps": { "type": "html", "label": "Repro Steps" },
    "system_info": { "type": "html", "label": "System Info" },
    "category": {
      "type": "selection",
      "label": "Category",
      "options": [{ "value": "business", "label": "Business" }, { "value": "architectural", "label": "Architectural" }]
    },
    "resolved_reason": {
      "type": "selection",
      "label": "Resolved Reason",
      "options": [
        { "value": "fixed", "label": "Fixed" },
        { "value": "duplicate", "label": "Duplicate" },
        { "value": "as_designed", "label": "As Designed" },
        { "value": "cannot_reproduce", "label": "Cannot Reproduce" }
      ]
    },
    "story_points": { "type": "float", "label": "Story Points" },
    "priority": {
      "type": "selection",
      "label": "Priority",
      "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }]
    },
    "severity": {
      "type": "selection",
      "label": "Severity",
      "options": [
        { "value": "1", "label": "1 - Critical" },
        { "value": "2", "label": "2 - High" },
        { "value": "3", "label": "3 - Medium" },
        { "value": "4", "label": "4 - Low" }
      ]
    },
    "activity": {
      "type": "selection",
      "label": "Activity",
      "options": [
        { "value": "deployment", "label": "Deployment" },
        { "value": "design", "label": "Design" },
        { "value": "development", "label": "Development" },
        { "value": "documentation", "label": "Documentation" },
        { "value": "requirements", "label": "Requirements" },
        { "value": "testing", "label": "Testing" }
      ]
    },
    "original_estimate": { "type": "float", "label": "Original Estimate" },
    "remaining_work": { "type": "float", "label": "Remaining" },
    "completed_work": { "type": "float", "label": "Completed" },
    "dev_links": { "type": "many2many", "label": "Development", "relation": "dev.link" },
    "related": { "type": "many2many", "label": "Related Work", "relation": "work.item" },
    "found_in": { "type": "char", "label": "Found in Build" },
    "integrated_in": { "type": "char", "label": "Integrated in Build" },
    "changed_by": { "type": "many2one", "label": "Changed By", "relation": "res.users", "readonly": true },
    "changed_date": { "type": "datetime", "label": "Changed Date", "readonly": true },
    "following": { "type": "boolean", "label": "Following", "readonly": true },
    "attachments": { "type": "binary", "label": "Attachments", "multiple": true }
  },
  "layout": {
    "type": "sheet",
    "id": "bug",
    "head": {
      "kind": {
        "field": "work_type",
        "numberField": "number",
        "looks": { "bug": { "colour": "#cc293d", "icon": "bug" }, "task": { "colour": "#f2cb1d", "icon": "task" }, "story": { "colour": "#009ccc", "icon": "story" } }
      },
      "meta": [
        {
          "type": "field",
          "id": "h-assigned",
          "field": "assigned_to",
          "labels": "hidden",
          "placeholder": "No one selected",
          "options": { "avatar": true }
        },
        {
          "type": "link",
          "id": "h-comments",
          "icon": "chat",
          "field": "comment_count",
          "words": { "one": "Comment", "other": "Comments" },
          "target": "g-discussion"
        },
        {
          "type": "field",
          "id": "h-tags",
          "field": "tags",
          "widget": "tags",
          "labels": "hidden",
          "placeholder": "Add Tag",
          "options": { "adder": "button" }
        }
      ],
      "actions": [
        {
          "type": "button",
          "id": "b-save-close",
          "label": "Save and Close",
          "icon": "save",
          "primaryWhenChanged": true,
          "steps": [{ "do": "save" }, { "do": "close" }],
          "menu": [{ "id": "m-save", "label": "Save", "steps": [{ "do": "save" }] }]
        },
        {
          "type": "button",
          "id": "b-follow",
          "label": "Follow",
          "pressedLabel": "Following",
          "icon": "eye",
          "pressed": "following",
          "action": "follow",
          "menuIcon": "gear",
          "menuLabel": "Notification settings",
          "menu": [
            { "id": "m-follow-all", "label": "All changes", "action": "follow-all" },
            { "id": "m-follow-state", "label": "State changes", "action": "follow-state" }
          ]
        },
        { "type": "button", "id": "b-refresh", "label": "Refresh", "icon": "refresh", "iconOnly": true, "steps": [{ "do": "reload" }] },
        { "type": "button", "id": "b-undo", "label": "Revert changes", "icon": "undo", "iconOnly": true, "steps": [{ "do": "reset" }] }
      ],
      "band": {
        "tracks": ["274px", "1fr"],
        "labelWidth": 76,
        "children": [
          {
            "type": "field",
            "id": "f-state",
            "field": "state",
            "widget": "dot",
            "hotkey": "e",
            "options": { "label": true, "listDots": false, "colours": { "new": "#b2b2b2", "active": "#007acc", "resolved": "#ff9d00", "closed": "#339933" } }
          },
          { "type": "field", "id": "f-area", "field": "area", "widget": "path", "hotkey": "a" },
          { "type": "field", "id": "f-reason", "field": "reason", "readonly": true, "readonlyReason": "Set by the workflow when the State changes" },
          { "type": "field", "id": "f-iteration", "field": "iteration", "widget": "path", "hotkey": "r" }
        ]
      },
      "updated": { "byField": "changed_by", "atField": "changed_date", "opens": "t-history" }
    },
    "title": { "field": "title", "before": [{ "type": "field", "id": "t-number", "field": "number", "labels": "hidden" }] },
    "toolbar": { "menu": [{ "id": "m-copy-link", "label": "Copy link", "action": "copy-link" }, { "id": "m-delete", "builtin": "delete" }] },
    "children": [
      {
        "type": "tabs",
        "id": "wi-tabs",
        "place": "head",
        "children": [
          {
            "type": "tab",
            "id": "t-details",
            "label": "Details",
            "children": [
              {
                "type": "section",
                "id": "cols",
                "style": "plain",
                "columns": 3,
                "tracks": ["50%", "1fr", "1fr"],
                "gap": 16,
                "children": [
                  {
                    "type": "section",
                    "id": "col-1",
                    "style": "plain",
                    "children": [
                      {
                        "type": "section",
                        "id": "g-repro",
                        "title": "Repro Steps",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "maximise": true,
                        "children": [
                          {
                            "type": "field",
                            "id": "f-repro",
                            "field": "repro_steps",
                            "labels": "hidden",
                            "options": {
                              "editor": "markdown",
                              "toolbar": "focus",
                              "tools": [
                                "mention",
                                "reference",
                                "attach",
                                "highlight",
                                "heading",
                                "bold",
                                "italic",
                                "code",
                                "link",
                                "bulletList",
                                "numberList",
                                "taskList"
                              ],
                              "mention": { "model": "res.users" },
                              "references": [
                                { "key": "#", "model": "work.item", "label": "Work item", "icon": "hash" },
                                { "key": "!", "model": "pull.request", "label": "Pull request", "icon": "pull-request" }
                              ]
                            }
                          }
                        ]
                      },
                      {
                        "type": "section",
                        "id": "g-system",
                        "title": "System Info",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "maximise": true,
                        "children": [
                          {
                            "type": "field",
                            "id": "f-system",
                            "field": "system_info",
                            "labels": "hidden",
                            "placeholder": "Click to add System Info.",
                            "options": {
                              "editor": "rich",
                              "toolbar": "focus",
                              "toolbarAt": "bottom",
                              "switchEditor": true,
                              "tools": [
                                "bold",
                                "italic",
                                "underline",
                                "bulletList",
                                "numberList",
                                "highlight",
                                "colour",
                                "emoji",
                                "outdent",
                                "indent",
                                "strike",
                                "size",
                                "code",
                                "mention",
                                "reference",
                                "clearFormatting",
                                "image",
                                "link",
                                "unlink"
                              ],
                              "mention": { "model": "res.users" },
                              "references": [
                                { "key": "#", "model": "work.item", "label": "Work item", "icon": "hash" },
                                { "key": "!", "model": "pull.request", "label": "Pull request", "icon": "pull-request" }
                              ]
                            }
                          }
                        ]
                      },
                      {
                        "type": "section",
                        "id": "g-discussion",
                        "title": "Discussion",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "maximise": true,
                        "children": [{ "type": "slot", "id": "s-discussion", "name": "discussion" }]
                      }
                    ]
                  },
                  {
                    "type": "section",
                    "id": "col-2",
                    "style": "plain",
                    "children": [
                      {
                        "type": "section",
                        "id": "g-planning",
                        "title": "Planning",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "children": [
                          { "type": "field", "id": "f-category", "field": "category", "options": { "list": "own" } },
                          {
                            "type": "field",
                            "id": "f-resolved-reason",
                            "field": "resolved_reason",
                            "readonly": true,
                            "readonlyReason": "Set when the bug is resolved"
                          },
                          { "type": "field", "id": "f-points", "field": "story_points" },
                          { "type": "field", "id": "f-priority", "field": "priority", "options": { "list": "own" } },
                          { "type": "field", "id": "f-severity", "field": "severity", "options": { "list": "own" } },
                          { "type": "field", "id": "f-activity", "field": "activity", "options": { "list": "own" } }
                        ]
                      },
                      {
                        "type": "section",
                        "id": "g-effort",
                        "title": "Effort (Hours)",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "children": [
                          { "type": "field", "id": "f-estimate", "field": "original_estimate" },
                          { "type": "field", "id": "f-remaining", "field": "remaining_work" },
                          { "type": "field", "id": "f-completed", "field": "completed_work" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "section",
                    "id": "col-3",
                    "style": "plain",
                    "children": [
                      {
                        "type": "section",
                        "id": "g-deployment",
                        "title": "Deployment",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "children": [
                          {
                            "type": "text",
                            "id": "x-deployment",
                            "style": "help",
                            "text": "To track releases associated with this work item, go to [Releases](https://example.com/releases) and turn on deployment status reporting for Boards in your pipeline's Options menu. [Learn more about deployment status reporting](https://example.com/help/deployment-status)"
                          }
                        ]
                      },
                      {
                        "type": "section",
                        "id": "g-development",
                        "title": "Development",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "children": [
                          {
                            "type": "field",
                            "id": "f-dev",
                            "field": "dev_links",
                            "widget": "links",
                            "labels": "hidden",
                            "options": {
                              "add": "search",
                              "helpIcon": "branch",
                              "helpTile": "#d84a12",
                              "help": "Link a [commit](https://example.com/help/commit), [pull request](https://example.com/help/pull-request) or [branch](https://example.com/help/branch) to see the status of your development. You can also [create a branch](https://example.com/help/new-branch) to get started."
                            }
                          }
                        ]
                      },
                      {
                        "type": "section",
                        "id": "g-related",
                        "title": "Related Work",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "children": [
                          {
                            "type": "field",
                            "id": "f-related",
                            "field": "related",
                            "widget": "links",
                            "labels": "hidden",
                            "options": { "add": "menu", "emptyLink": "Add an existing work item as a parent" }
                          }
                        ]
                      },
                      {
                        "type": "section",
                        "id": "g-build",
                        "title": "System Info",
                        "style": "line",
                        "collapsible": true,
                        "foldAt": "end",
                        "children": [{ "type": "field", "id": "f-found", "field": "found_in" }, { "type": "field", "id": "f-integrated", "field": "integrated_in" }]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "tab",
            "id": "t-history",
            "label": "History",
            "icon": "history",
            "iconOnly": true,
            "children": [{ "type": "slot", "id": "s-history", "name": "history" }]
          },
          {
            "type": "tab",
            "id": "t-links",
            "label": "Links",
            "icon": "link",
            "iconOnly": true,
            "count": "related",
            "children": [{ "type": "field", "id": "f-links-all", "field": "related", "widget": "links", "labels": "hidden", "options": { "add": "menu" } }]
          },
          {
            "type": "tab",
            "id": "t-attachments",
            "label": "Attachments",
            "icon": "attach",
            "iconOnly": true,
            "count": "attachments",
            "children": [{ "type": "field", "id": "f-files", "field": "attachments", "labels": "hidden" }]
          }
        ]
      }
    ]
  },
