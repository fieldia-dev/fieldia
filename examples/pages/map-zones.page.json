{
  "fieldia": "0.5",
  "id": "map-zones",
  "title": "Orders this week, by district",
  "description": "Each district is shaded by how many of the week's orders it has: the legend says how many each shade means. A round mark with a number counts the orders close together on the map, whichever district they are in; zoom in and it parts into each order. Press a district to list its orders.",
  "data": {
    "kind": "record",
    "model": "shop.order"
  },
  "fields": {
    "name": {
      "type": "char",
      "label": "Order"
    },
    "customer": {
      "type": "char",
      "label": "Customer"
    },
    "district": {
      "type": "selection",
      "label": "District",
      "options": [
        {
          "value": "downtown",
          "label": "Downtown"
        },
        {
          "value": "zamalek",
          "label": "Zamalek"
        },
        {
          "value": "garden_city",
          "label": "Garden City"
        },
        {
          "value": "dokki",
          "label": "Dokki"
        },
        {
          "value": "mohandessin",
          "label": "Mohandessin"
        },
        {
          "value": "imbaba",
          "label": "Imbaba"
        },
        {
          "value": "shubra",
          "label": "Shubra"
        },
        {
          "value": "abbasia",
          "label": "Abbasia"
        },
        {
          "value": "heliopolis",
          "label": "Heliopolis"
        },
        {
          "value": "nasr_city",
          "label": "Nasr City"
        },
        {
          "value": "mokattam",
          "label": "Mokattam"
        },
        {
          "value": "old_cairo",
          "label": "Old Cairo"
        },
        {
          "value": "giza",
          "label": "Giza"
        },
        {
          "value": "maadi",
          "label": "Maadi"
        }
      ]
    },
    "place": {
      "type": "json",
      "label": "Deliver to"
    },
    "total": {
      "type": "monetary",
      "label": "Total",
      "currency": "EGP"
    },
    "status": {
      "type": "selection",
      "label": "Status",
      "options": [
        {
          "value": "new",
          "label": "New"
        },
        {
          "value": "on_the_way",
          "label": "On the way"
        },
        {
          "value": "delivered",
          "label": "Delivered"
        }
      ]
    }
  },
  "layout": {
    "type": "list",
    "id": "orders",
    "columns": [
      "name",
      "customer",
      "district",
      "total",
      "status"
    ],
    "sort": [
      {
        "field": "name"
      }
    ],
    "pageSize": 10,
    "searchFields": [
      "name",
      "customer",
      "district",
      "status"
    ],
    "card": {
      "title": "name",
      "subtitle": "customer",
      "status": "status",
      "fields": [
        "total",
        "district"
      ]
    },
    "filters": [
      {
        "id": "open",
        "label": "Not delivered",
        "filter": [
          {
            "field": "status",
            "op": "!=",
            "value": "delivered"
          }
        ]
      }
    ],
    "groupBy": [
      "district",
      "status"
    ],
    "map": {
      "point": "place",
      "pin": {
        "look": "dot",
        "tones": [
          {
            "tone": "success",
            "when": "status == 'delivered'"
          },
          {
            "tone": "warning",
            "when": "status == 'on_the_way'"
          }
        ]
      },
      "card": {
        "title": "name",
        "fields": [
          "customer",
          "district",
          "total",
          "status"
        ]
      },
      "regions": {
        "from": "cairo-districts",
        "key": "code",
        "name": "name",
        "field": "district"
      },
      "tools": [
        "fullscreen",
        "measure",
        "nearest"
      ],
      "view": "both"
    }
  }
}
