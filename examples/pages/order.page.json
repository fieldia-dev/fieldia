{
  "fieldia": "0.1",
  "id": "sales-order",
  "title": "Sales order",
  "data": { "kind": "record", "model": "sale.order" },
  "fields": {
    "name": { "type": "char", "label": "Order", "required": true },
    "state": {
      "type": "selection",
      "label": "Status",
      "options": [
        { "value": "draft", "label": "Quotation" },
        { "value": "sent", "label": "Quotation sent" },
        { "value": "sale", "label": "Sales order" }
      ],
      "default": "draft"
    },
    "partner_id": { "type": "many2one", "label": "Customer", "relation": "partner", "required": true },
    "date_order": { "type": "date", "label": "Order date" },
    "payment_term": {
      "type": "selection",
      "label": "Payment terms",
      "options": [
        { "value": "now", "label": "Immediate" },
        { "value": "30", "label": "30 days" },
        { "value": "60", "label": "60 days" }
      ]
    },
    "line_ids": {
      "type": "one2many",
      "label": "Order lines",
      "relation": "sale.order.line",
      "lineKinds": { "field": "display_type", "text": "name" },
      "sequenceField": "sequence",
      "fields": {
        "sequence": { "type": "integer", "label": "Sequence" },
        "display_type": {
          "type": "selection",
          "label": "Line type",
          "options": [
            { "value": "section", "label": "Section" },
            { "value": "note", "label": "Note" }
          ]
        },
        "product_id": { "type": "many2one", "label": "Product", "relation": "product", "required": true },
        "name": { "type": "char", "label": "Description" },
        "qty": { "type": "float", "label": "Quantity", "digits": [8, 2] },
        "price": { "type": "monetary", "label": "Unit price", "currency": "EGP" },
        "discount": { "type": "float", "label": "Disc. %", "digits": [5, 1] },
        "taxed": { "type": "boolean", "label": "VAT 14%" },
        "subtotal": { "type": "monetary", "label": "Subtotal", "currency": "EGP", "readonly": true }
      }
    },
    "amount_untaxed": { "type": "monetary", "label": "Untaxed amount", "currency": "EGP", "readonly": true },
    "amount_tax": { "type": "monetary", "label": "VAT", "currency": "EGP", "readonly": true },
    "amount_total": { "type": "monetary", "label": "Total", "currency": "EGP", "readonly": true },
    "note": { "type": "text", "label": "Terms and conditions" }
  },
  "layout": {
    "type": "sheet",
    "id": "sheet",
    "title": { "field": "name" },
    "statusbar": { "field": "state", "clickable": true },
    "children": [
      {
        "type": "section",
        "id": "header",
        "columns": 2,
        "children": [
          { "type": "field", "id": "f-partner", "field": "partner_id" },
          { "type": "field", "id": "f-date", "field": "date_order" },
          { "type": "field", "id": "f-terms", "field": "payment_term" }
        ]
      },
      {
        "type": "tabs",
        "id": "notebook",
        "children": [
          {
            "type": "tab",
            "id": "tab-lines",
            "label": "Order lines",
            "children": [
              { "type": "field", "id": "f-lines", "field": "line_ids", "widget": "grid", "totals": ["qty", "subtotal"] },
              {
                "type": "section",
                "id": "totals",
                "columns": 3,
                "children": [
                  { "type": "field", "id": "f-untaxed", "field": "amount_untaxed" },
                  { "type": "field", "id": "f-tax", "field": "amount_tax" },
                  { "type": "field", "id": "f-total", "field": "amount_total" }
                ]
              }
            ]
          },
          {
            "type": "tab",
            "id": "tab-other",
            "label": "Other information",
            "children": [{ "type": "field", "id": "f-note", "field": "note" }]
          }
        ]
      }
    ]
  }
}
