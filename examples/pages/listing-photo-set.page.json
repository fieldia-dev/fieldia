      "For rent": "للإيجار",
      "Price": "السعر",
      "District": "الحي",
      "Zamalek": "الزمالك",
      "Maadi": "المعادي",
      "New Cairo": "القاهرة الجديدة",
      "Sheikh Zayed": "الشيخ زايد",
      "Bedrooms": "غرف النوم",
