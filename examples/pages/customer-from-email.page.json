  "suggest": {
    "label": "Fill from an e-mail",
    "placeholder": "Paste the e-mail, or its signature, here",
    "fields": [
      "name",
      "email",
      "phone",
      "website",
      "vat",
      "street",
      "city",
      "country_id",
      "child_ids"
    ]
  }
