{
  "fieldia": "0.1",
  "id": "real-contact",
  "title": "Contact",
  "description": "Sherkety ERP's contact form (res.partner, base.view_partner_form) as a user with Sales, Purchase, Invoicing, CRM and the Egyptian e-invoicing module sees it.",
  "data": { "kind": "record", "model": "res.partner" },
  "maxWidth": "full",
  "fields": {
    "name": { "type": "char", "label": "Name", "required": true },
    "image_1920": { "type": "image", "label": "Image", "maxSize": 2097152 },
    "company_type": {
      "type": "selection",
      "label": "Company Type",
      "options": [{ "value": "person", "label": "Individual" }, { "value": "company", "label": "Company" }],
      "default": "person"
    },
    "is_company": { "type": "boolean", "label": "Is a Company", "default": false },
    "active": { "type": "boolean", "label": "Active", "default": true },
    "parent_id": {
      "type": "many2one",
      "label": "Related Company",
      "relation": "res.partner",
      "filter": [{ "field": "is_company", "op": "=", "value": true }],
      "createValues": { "company_type": "'company'", "is_company": "True", "user_id": "user_id", "vat": "vat" }
    },
    "company_name": { "type": "char", "label": "Company Name" },
    "type": {
      "type": "selection",
      "label": "Address Type",
      "options": [
        { "value": "contact", "label": "Contact" },
        { "value": "invoice", "label": "Invoice Address" },
        { "value": "delivery", "label": "Delivery Address" },
        { "value": "other", "label": "Other Address" }
      ],
      "default": "contact"
    },
    "street": { "type": "char", "label": "Street" },
    "street2": { "type": "char", "label": "Street 2" },
    "l10n_eg_building_no": { "type": "char", "label": "Building No." },
    "city": { "type": "char", "label": "City" },
    "state_id": {
      "type": "many2one",
      "label": "State",
      "relation": "res.country.state",
      "filter": [{ "field": "country_id", "op": "=?", "valueFrom": "country_id" }]
    },
    "zip": { "type": "char", "label": "ZIP" },
    "country_id": { "type": "many2one", "label": "Country", "relation": "res.country" },
    "country_code": { "type": "char", "label": "Country Code", "readonly": true },
    "vat": { "type": "char", "label": "Tax ID" },
    "function": { "type": "char", "label": "Job Position" },
    "phone": { "type": "char", "label": "Phone" },
    "mobile": { "type": "char", "label": "Mobile" },
    "email": { "type": "char", "label": "Email" },
    "is_blacklisted": { "type": "boolean", "label": "Blacklist", "readonly": true },
    "user_ids": { "type": "many2many", "label": "Users", "relation": "res.users" },
    "website": { "type": "char", "label": "Website" },
    "title": { "type": "many2one", "label": "Title", "relation": "res.partner.title" },
    "active_lang_count": { "type": "integer", "label": "Active Lang Count", "readonly": true },
    "lang": {
      "type": "selection",
      "label": "Language",
      "options": [{ "value": "en_US", "label": "English (US)" }, { "value": "ar_001", "label": "Arabic / العربية" }]
    },
    "category_id": { "type": "many2many", "label": "Tags", "relation": "res.partner.category" },
    "same_vat_partner_id": { "type": "many2one", "label": "Partner with same Tax ID", "relation": "res.partner", "readonly": true },
    "same_company_registry_partner_id": { "type": "many2one", "label": "Partner with same Company Registry", "relation": "res.partner", "readonly": true },
    "duplicated_bank_account_partners_count": { "type": "integer", "label": "Duplicated Bank Account Partners Count", "readonly": true },
    "child_ids": {
      "type": "one2many",
      "label": "Contact",
      "relation": "res.partner",
      "fields": {
        "type": {
          "type": "selection",
          "label": "Address Type",
          "required": true,
          "options": [
            { "value": "contact", "label": "Contact" },
            { "value": "invoice", "label": "Invoice Address" },
            { "value": "delivery", "label": "Delivery Address" },
            { "value": "other", "label": "Other Address" }
          ]
        },
        "name": { "type": "char", "label": "Contact Name" },
        "title": { "type": "many2one", "label": "Title", "relation": "res.partner.title" },
        "function": { "type": "char", "label": "Job Position" },
        "street": { "type": "char", "label": "Street" },
        "street2": { "type": "char", "label": "Street 2" },
        "city": { "type": "char", "label": "City" },
        "state_id": { "type": "many2one", "label": "State", "relation": "res.country.state" },
        "zip": { "type": "char", "label": "ZIP" },
        "country_id": { "type": "many2one", "label": "Country", "relation": "res.country" },
        "email": { "type": "char", "label": "Email" },
        "phone": { "type": "char", "label": "Phone" },
        "mobile": { "type": "char", "label": "Mobile" },
        "comment": { "type": "text", "label": "Notes" }
      },
      "lineDefaults": {
        "type": "'other'",
        "street": "street",
        "street2": "street2",
        "city": "city",
        "state_id": "state_id",
        "zip": "zip",
        "country_id": "country_id"
      }
    },
    "user_id": {
      "type": "many2one",
      "label": "Salesperson",
      "relation": "res.users",
      "help": "The internal user in charge of this contact.",
      "filter": [{ "field": "share", "op": "!=", "value": true }]
    },
    "team_id": { "type": "many2one", "label": "Sales Team", "relation": "crm.team" },
    "property_payment_term_id": {
      "type": "many2one",
      "label": "Payment Terms",
      "relation": "account.payment.term",
      "help": "This payment term will be used instead of the default one for sales orders and customer invoices"
    },
    "property_product_pricelist": { "type": "many2one", "label": "Pricelist", "relation": "product.pricelist" },
    "buyer_id": { "type": "many2one", "label": "Buyer", "relation": "res.users" },
    "property_supplier_payment_term_id": {
      "type": "many2one",
      "label": "Payment Terms",
      "relation": "account.payment.term",
      "help": "This payment term will be used instead of the default one for purchase orders and vendor bills"
    },
    "property_purchase_currency_id": {
      "type": "many2one",
      "label": "Supplier Currency",
      "relation": "res.currency",
      "help": "This currency will be used for purchases from the current partner"
    },
    "receipt_reminder_email": {
      "type": "boolean",
      "label": "Receipt Reminder",
      "help": "Automatically send a confirmation email to the vendor X days before the expected receipt date, asking him to confirm the exact date."
    },
    "reminder_date_before_receipt": {
      "type": "integer",
      "label": "Days Before Receipt",
      "default": 1,
      "help": "Number of days to send reminder email before the promised receipt date"
    },
    "property_account_position_id": {
      "type": "many2one",
      "label": "Fiscal Position",
      "relation": "account.fiscal.position",
      "help": "The fiscal position determines the taxes/accounts used for this contact."
    },
    "company_registry": {
      "type": "char",
      "label": "Company ID",
      "help": "The registry number of the company. Use it if it is different from the Tax ID. It must be unique across all partners of a same country"
    },
    "ref": { "type": "char", "label": "Reference" },
    "company_id": { "type": "many2one", "label": "Company", "relation": "res.company" },
    "industry_id": { "type": "many2one", "label": "Industry", "relation": "res.partner.industry" },
    "l10n_eg_tax_card_no": {
      "type": "char",
      "label": "Tax Card No (البطاقة الضريبية)",
      "help": "Egyptian Tax Card number. Required for vendors located in Egypt."
    },
    "l10n_eg_tax_file_no": {
      "type": "char",
      "label": "Tax File No (الملف الضريبي)",
      "help": "Egyptian Tax File number. Required for vendors located in Egypt."
    },
    "l10n_eg_tax_record_no": {
      "type": "char",
      "label": "Tax Record No (السجل الضريبي)",
      "help": "Egyptian Commercial Tax Record number. Required for vendors located in Egypt."
    },
    "bank_ids": {
      "type": "one2many",
      "label": "Banks",
      "relation": "res.partner.bank",
      "sequenceField": "sequence",
      "fields": {
        "sequence": { "type": "integer", "label": "Sequence" },
        "acc_number": { "type": "char", "label": "Account Number", "required": true },
        "bank_id": { "type": "many2one", "label": "Bank", "relation": "res.bank" },
        "allow_out_payment": { "type": "boolean", "label": "Send Money" }
      }
    },
    "currency_id": { "type": "many2one", "label": "Currency", "relation": "res.currency", "readonly": true },
    "property_account_receivable_id": {
      "type": "many2one",
      "label": "Account Receivable",
      "relation": "account.account",
      "filter": [{ "field": "account_type", "op": "=", "value": "asset_receivable" }]
    },
    "property_account_payable_id": {
      "type": "many2one",
      "label": "Account Payable",
      "relation": "account.account",
      "filter": [{ "field": "account_type", "op": "=", "value": "liability_payable" }]
    },
    "show_credit_limit": { "type": "boolean", "label": "Show Credit Limit", "readonly": true },
    "credit": {
      "type": "monetary",
      "label": "Total Receivable",
      "currencyField": "currency_id",
      "readonly": true,
      "help": "Total amount this customer owes you."
    },
    "days_sales_outstanding": {
      "type": "float",
      "label": "Days Sales Outstanding (DSO)",
      "readonly": true,
      "digits": [16, 2],
      "help": "[(Total Receivable/Total Revenue) * number of days since the first invoice] for this customer"
    },
    "use_partner_credit_limit": { "type": "boolean", "label": "Partner Limit", "help": "Set a value greater than 0.0 to activate a credit limit check" },
    "credit_limit": { "type": "monetary", "label": "Credit Limit", "currencyField": "currency_id", "min": 0, "help": "Credit limit specific to this partner." },
    "comment": { "type": "html", "label": "Notes" },
    "sale_warn": {
      "type": "selection",
      "label": "Sales Warnings",
      "options": [
        { "value": "no-message", "label": "No Message" },
        { "value": "warning", "label": "Warning" },
        { "value": "block", "label": "Blocking Message" }
      ],
      "default": "no-message"
    },
    "sale_warn_msg": { "type": "text", "label": "Message for Sales Order" },
    "invoice_warn": {
      "type": "selection",
      "label": "Invoice",
      "options": [
        { "value": "no-message", "label": "No Message" },
        { "value": "warning", "label": "Warning" },
        { "value": "block", "label": "Blocking Message" }
      ],
      "default": "no-message"
    },
    "invoice_warn_msg": { "type": "text", "label": "Message for Invoice" },
    "purchase_warn": {
      "type": "selection",
      "label": "Purchase Order Warning",
      "options": [
        { "value": "no-message", "label": "No Message" },
        { "value": "warning", "label": "Warning" },
        { "value": "block", "label": "Blocking Message" }
      ],
      "default": "no-message"
    },
    "purchase_warn_msg": { "type": "text", "label": "Message for Purchase Order" },
    "opportunity_count": { "type": "integer", "label": "Opportunities", "readonly": true },
    "meeting_count": { "type": "integer", "label": "Meetings", "readonly": true },
    "sale_order_count": { "type": "integer", "label": "Sales", "readonly": true },
    "total_invoiced": { "type": "monetary", "label": "Invoiced", "currencyField": "currency_id", "readonly": true },
    "supplier_invoice_count": { "type": "integer", "label": "Vendor Bills", "readonly": true },
    "purchase_order_count": { "type": "integer", "label": "Purchases", "readonly": true }
  },
  "layout": {
    "type": "sheet",
    "id": "sheet",
    "title": {
      "field": "name",
      "avatarField": "image_1920",
      "placeholder": "e.g. Brandom Freeman",
      "placeholderWhen": [{ "when": "is_company", "text": "e.g. Lumber Inc" }],
      "focus": true,
      "above": [{ "type": "field", "id": "f-company-type", "field": "company_type", "widget": "radio", "labels": "hidden", "options": { "clear": false } }],
      "below": [
        {
          "type": "field",
          "id": "f-parent",
          "field": "parent_id",
          "placeholder": "Company Name...",
          "labels": "hidden",
          "invisible": "((is_company and not parent_id) or company_name) and company_name != ''"
        },
        {
          "type": "field",
          "id": "f-company-name",
          "field": "company_name",
          "labels": "hidden",
          "readonly": true,
          "invisible": "not company_name or company_name == '' or is_company"
        }
      ]
    },
    "statButtons": [
      {
        "id": "stat-opportunities",
        "label": "Opportunities",
        "field": "opportunity_count",
        "icon": "star",
        "action": "partner_view_opportunities",
        "roles": ["sales_team.group_sale_salesman"]
      },
      { "id": "stat-meetings", "label": "Meetings", "field": "meeting_count", "icon": "calendar", "action": "partner_schedule_meeting" },
      {
        "id": "stat-sales",
        "label": "Sales",
        "field": "sale_order_count",
        "icon": "money",
        "action": "partner_view_sale_orders",
        "roles": ["sales_team.group_sale_salesman"]
      },
      {
        "id": "stat-invoiced",
        "label": "Invoiced",
        "field": "total_invoiced",
        "icon": "edit",
        "action": "partner_view_invoices",
        "roles": ["account.group_account_invoice", "account.group_account_readonly"]
      },
      {
        "id": "stat-vendor-bills",
        "label": "Vendor Bills",
        "field": "supplier_invoice_count",
        "icon": "edit",
        "action": "partner_view_vendor_bills",
        "invisible": "supplier_invoice_count == 0",
        "roles": ["account.group_account_invoice", "account.group_account_readonly"]
      },
      {
        "id": "stat-purchases",
        "label": "Purchases",
        "field": "purchase_order_count",
        "icon": "cart",
        "action": "partner_view_purchases",
        "roles": ["purchase.group_purchase_user"]
      }
    ],
    "ribbon": { "id": "ribbon-archived", "label": "Archived", "tone": "danger", "invisible": "active" },
    "alerts": [
      {
        "id": "warning-tax",
        "message": "A partner with the same Tax ID already exists ({same_vat_partner_id}), are you sure to create a new one?",
        "tone": "warning",
        "invisible": "not same_vat_partner_id",
        "buttons": [
          {
            "type": "button",
            "id": "open-same-vat",
            "label": "Open it",
            "steps": [{ "do": "open", "page": "real-contact", "as": "dialog", "record": "same_vat_partner_id" }]
          }
        ]
      },
      {
        "id": "warning-company",
        "message": "A partner with the same Company Registry already exists ({same_company_registry_partner_id}), are you sure to create a new one?",
        "tone": "warning",
        "invisible": "not same_company_registry_partner_id",
        "buttons": [
          {
            "type": "button",
            "id": "open-same-registry",
            "label": "Open it",
            "steps": [{ "do": "open", "page": "real-contact", "as": "dialog", "record": "same_company_registry_partner_id" }]
          }
        ]
      },
      {
        "id": "warning-bank",
        "message": "One or more Bank Accounts set on this partner are also used by other Partners. Please make sure that this is a wanted behavior.",
        "tone": "warning",
        "invisible": "duplicated_bank_account_partners_count == 0",
        "buttons": [{ "type": "button", "id": "open-bank-partners", "label": "Partners", "action": "action_view_partner_with_same_bank" }]
      }
    ],
    "children": [
      {
        "type": "button",
        "id": "create-company",
        "label": "Create company",
        "icon": "building",
        "style": "link",
        "action": "partner_create_company",
        "invisible": "is_company or company_name == '' or not company_name or not editing"
      },
      {
        "type": "section",
        "id": "main",
        "style": "plain",
        "columns": { "wide": 2, "medium": 2 },
        "children": [
          {
            "type": "section",
            "id": "main-left",
            "style": "plain",
            "children": [
              { "type": "field", "id": "f-type", "field": "type", "invisible": "is_company", "readonly": "user_ids", "required": "not is_company" },
              { "type": "text", "id": "t-address", "text": "Address", "style": "heading", "invisible": "not is_company" },
              {
                "type": "section",
                "id": "address",
                "style": "plain",
                "columns": { "wide": 12, "medium": 12 },
                "labels": "hidden",
                "readonly": "type == 'contact' and parent_id",
                "children": [
                  { "type": "field", "id": "f-street", "field": "street", "placeholder": "Street...", "colspan": 12 },
                  { "type": "field", "id": "f-street2", "field": "street2", "placeholder": "Street 2...", "colspan": 12 },
                  { "type": "field", "id": "f-building-no", "field": "l10n_eg_building_no", "placeholder": "Building Number", "colspan": 12 },
                  { "type": "field", "id": "f-city", "field": "city", "placeholder": "City", "colspan": 5 },
                  {
                    "type": "field",
                    "id": "f-state",
                    "field": "state_id",
                    "placeholder": "State",
                    "colspan": 4,
                    "options": { "open": false, "create": false }
                  },
                  { "type": "field", "id": "f-zip", "field": "zip", "placeholder": "ZIP", "colspan": 3 },
                  {
                    "type": "field",
                    "id": "f-country",
                    "field": "country_id",
                    "placeholder": "Country",
                    "colspan": 12,
                    "options": { "create": false, "open": false }
                  }
                ]
              },
              { "type": "field", "id": "f-vat", "field": "vat", "placeholder": "e.g. BE0477472701", "readonly": "parent_id" }
            ]
          },
          {
            "type": "section",
            "id": "main-right",
            "style": "plain",
            "children": [
              { "type": "field", "id": "f-function", "field": "function", "placeholder": "e.g. Sales Director", "invisible": "is_company" },
              { "type": "field", "id": "f-phone", "field": "phone", "widget": "phone" },
              { "type": "field", "id": "f-mobile", "field": "mobile", "widget": "phone" },
              {
                "type": "button",
                "id": "email-blacklist-remove",
                "label": "Unblacklist this email",
                "icon": "warning",
                "style": "danger",
                "action": "mail_action_blacklist_remove",
                "invisible": "not is_blacklisted"
              },
              { "type": "field", "id": "f-email", "field": "email", "widget": "email", "required": "user_ids" },
              { "type": "field", "id": "f-website", "field": "website", "widget": "url", "placeholder": "e.g. https://sherkety.net" },
              { "type": "field", "id": "f-title", "field": "title", "placeholder": "e.g. Mister", "invisible": "is_company" },
              { "type": "field", "id": "f-lang", "field": "lang", "invisible": "active_lang_count <= 1" },
              {
                "type": "field",
                "id": "f-tags",
                "field": "category_id",
                "widget": "tags",
                "placeholder": "e.g. \"B2B\", \"VIP\", \"Consulting\", ...",
                "options": { "create": false, "colors": true }
              }
            ]
          }
        ]
      },
      {
        "type": "tabs",
        "id": "notebook",
        "children": [
          {
            "type": "tab",
            "id": "tab-contacts",
            "label": "Contacts & Addresses",
            "children": [
              {
                "type": "field",
                "id": "f-children",
                "field": "child_ids",
                "widget": "cards",
                "labels": "hidden",
                "columns": ["type", "name", "function", "email", "phone", "mobile", "street", "city", "country_id"],
                "options": { "itemLabel": "Contact", "addLabel": "Add" },
                "lineForm": {
                  "children": [
                    { "type": "field", "id": "child-type", "field": "type", "widget": "radio", "labels": "hidden", "required": true, "options": { "clear": false, "columns": "row" } },
                    { "type": "text", "id": "child-help-contact", "style": "note", "text": "Use this to organize the contact details of employees of a given company (e.g. CEO, CFO, ...).", "invisible": "type != 'contact'" },
                    { "type": "text", "id": "child-help-invoice", "style": "note", "text": "Preferred address for all invoices. Selected by default when you invoice an order that belongs to this company.", "invisible": "type != 'invoice'" },
                    { "type": "text", "id": "child-help-delivery", "style": "note", "text": "Preferred address for all deliveries. Selected by default when you deliver an order that belongs to this company.", "invisible": "type != 'delivery'" },
                    { "type": "text", "id": "child-help-other", "style": "note", "text": "Other address for the company (e.g. subsidiary, ...)", "invisible": "type != 'other'" },
                    { "type": "divider", "id": "child-divider" },
                    {
                      "type": "section",
                      "id": "child-main",
                      "style": "plain",
                      "columns": 2,
                      "children": [
                        {
                          "type": "section",
                          "id": "child-who",
                          "style": "plain",
                          "children": [
                            { "type": "field", "id": "child-name", "field": "name", "label": "Contact Name", "required": "type == 'contact'" },
                            { "type": "field", "id": "child-title", "field": "title", "placeholder": "e.g. Mr.", "invisible": "type != 'contact'", "options": { "open": false } },
                            { "type": "field", "id": "child-function", "field": "function", "placeholder": "e.g. Sales Director", "invisible": "type != 'contact'" },
                            {
                              "type": "section",
                              "id": "child-address",
                              "title": "Address",
                              "style": "plain",
                              "labels": "hidden",
                              "invisible": "type == 'contact'",
                              "children": [
                                { "type": "field", "id": "child-street", "field": "street", "placeholder": "Street..." },
                                { "type": "field", "id": "child-street2", "field": "street2", "placeholder": "Street 2..." },
                                { "type": "field", "id": "child-city", "field": "city", "placeholder": "City" },
                                { "type": "field", "id": "child-state", "field": "state_id", "placeholder": "State", "options": { "open": false } },
                                { "type": "field", "id": "child-zip", "field": "zip", "placeholder": "ZIP" },
                                { "type": "field", "id": "child-country", "field": "country_id", "placeholder": "Country", "options": { "open": false, "create": false } }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "section",
                          "id": "child-reach",
                          "style": "plain",
                          "children": [
                            { "type": "field", "id": "child-email", "field": "email", "widget": "email" },
                            { "type": "field", "id": "child-phone", "field": "phone", "widget": "phone" },
                            { "type": "field", "id": "child-mobile", "field": "mobile", "widget": "phone" }
                          ]
                        }
                      ]
                    },
