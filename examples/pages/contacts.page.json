{
  "fieldia": "0.3",
  "id": "contacts",
  "title": "Contacts",
  "data": { "kind": "record", "model": "crm.contact" },
  "fields": {
    "name": { "type": "char", "label": "Name", "required": true },
    "company": { "type": "char", "label": "Company" },
    "email": { "type": "char", "label": "Email" },
    "phone": { "type": "char", "label": "Phone" },
    "photo": { "type": "image", "label": "Photo" },
    "country_id": { "type": "many2one", "label": "Country", "relation": "country" },
    "state": {
      "type": "selection",
      "label": "Status",
      "required": true,
      "options": [
        { "value": "lead", "label": "Lead" },
        { "value": "customer", "label": "Customer" },
        { "value": "inactive", "label": "Inactive" },
        { "value": "blocked", "label": "Blocked" }
      ]
    },
    "owner_id": { "type": "many2one", "label": "Owner", "relation": "res.users" },
    "last_order": { "type": "date", "label": "Last order" },
    "currency_id": { "type": "many2one", "label": "Currency", "relation": "currency" },
    "lifetime_value": { "type": "monetary", "label": "Lifetime value", "currencyField": "currency_id", "readonly": true },
    "newsletter": { "type": "boolean", "label": "Newsletter" }
  },
  "layout": {
    "type": "list",
    "id": "contacts-list",
    "columns": ["name", "company", "country_id", "state", "owner_id", "last_order", "lifetime_value", "newsletter", "phone", "email"],
    "sort": [{ "field": "name" }],
    "pageSize": 10,
    "searchFields": ["name", "company", "email", "country_id", "owner_id"],
    "filters": [
      { "id": "customers", "label": "Customers", "filter": [{ "field": "state", "op": "=", "value": "customer" }] },
      { "id": "leads", "label": "Leads", "filter": [{ "field": "state", "op": "=", "value": "lead" }] },
      { "id": "newsletter", "label": "On the newsletter", "filter": [{ "field": "newsletter", "op": "=", "value": true }] }
    ],
    "groupBy": ["state", "country_id", "owner_id"],
    "cells": {
      "state": { "widget": "badge", "options": { "tones": { "customer": "success", "lead": "info", "inactive": "muted", "blocked": "danger" } } },
      "owner_id": { "widget": "avatar" },
      "phone": { "widget": "phone", "options": { "shown": "international", "links": true } }
    },
    "optionalColumns": { "company": "show", "country_id": "show", "owner_id": "show", "last_order": "show", "lifetime_value": "show", "newsletter": "show", "phone": "hide", "email": "hide" },
    "rowTones": [{ "tone": "muted", "when": "state == 'inactive'" }],
    "card": { "title": "name", "subtitle": "company", "image": "photo", "status": "state", "fields": ["phone", "owner_id", "lifetime_value"] },
    "export": true,
    "bulkEdit": ["state", "owner_id", "newsletter", "country_id"],
    "actions": [{ "type": "button", "id": "send-newsletter", "label": "Send newsletter", "action": "send_newsletter", "confirm": "Send the newsletter to the chosen contacts?" }]
  }
}
