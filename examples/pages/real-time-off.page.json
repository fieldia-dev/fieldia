{
  "fieldia": "0.1",
  "id": "real-time-off",
  "title": "Time Off Request",
  "description": "Sherkety ERP, hr_holidays: hr.leave, hr_leave_view_form as an approver opens it (hr_leave_view_form_manager), with hr_holidays_attendance's extra hours.",
  "data": {
    "kind": "record",
    "model": "hr.leave"
  },
  "maxWidth": "wide",
  "look": {
    "helpShown": "tooltip",
    "readonlyShown": "text",
    "labels": "beside",
    "labelWidth": 150
  },
  "fields": {
    "active": {
      "type": "boolean",
      "label": "Active",
      "readonly": true,
      "default": true
    },
    "can_reset": {
      "type": "boolean",
      "label": "Can reset",
      "readonly": true
    },
    "can_approve": {
      "type": "boolean",
      "label": "Can Approve",
      "readonly": true
    },
    "can_cancel": {
      "type": "boolean",
      "label": "Can Cancel",
      "readonly": true
    },
    "has_mandatory_day": {
      "type": "boolean",
      "label": "Has a mandatory day",
      "readonly": true
    },
    "state": {
      "type": "selection",
      "label": "Status",
      "default": "confirm",
      "options": [
        {
          "value": "draft",
          "label": "To Submit"
        },
        {
          "value": "confirm",
          "label": "To Approve"
        },
        {
          "value": "refuse",
          "label": "Refused"
        },
        {
          "value": "validate1",
          "label": "Second Approval"
        },
        {
          "value": "validate",
          "label": "Approved"
        }
      ]
    },
    "tz_mismatch": {
      "type": "boolean",
      "label": "Timezone mismatch",
      "readonly": true
    },
    "tz": {
      "type": "char",
      "label": "Timezone",
      "readonly": true
    },
    "holiday_type": {
      "type": "selection",
      "label": "Allocation Mode",
      "help": "By Employee: Allocation/Request for individual Employee, By Employee Tag: Allocation/Request for group of employees in category",
      "required": true,
      "default": "employee",
      "options": [
        {
          "value": "employee",
          "label": "By Employee"
        },
        {
          "value": "company",
          "label": "By Company"
        },
        {
          "value": "department",
          "label": "By Department"
        },
        {
          "value": "category",
          "label": "By Employee Tag"
        }
      ]
    },
    "leave_type_request_unit": {
      "type": "selection",
      "label": "Take Time Off in",
      "readonly": true,
      "options": [
        {
          "value": "day",
          "label": "Day"
        },
        {
          "value": "half_day",
          "label": "Half Day"
        },
        {
          "value": "hour",
          "label": "Hours"
        }
      ]
    },
    "validation_type": {
      "type": "selection",
      "label": "Validation Type",
      "readonly": true,
      "options": [
        {
          "value": "no_validation",
          "label": "No Validation"
        },
        {
          "value": "hr",
          "label": "By Time Off Officer"
        },
        {
          "value": "manager",
          "label": "By Employee's Approver"
        },
        {
          "value": "both",
          "label": "By Employee's Approver and Time Off Officer"
        }
      ]
    },
    "display_name": {
      "type": "char",
      "label": "Display Name",
      "readonly": true
    },
    "is_user_only_responsible": {
      "type": "boolean",
      "label": "Only responsible",
      "readonly": true
    },
    "mode_company_id": {
      "type": "many2one",
      "label": "Company",
      "relation": "res.company"
    },
    "category_id": {
      "type": "many2one",
      "label": "Employee Tag",
      "help": "Category of Employee",
      "relation": "hr.employee.category"
    },
    "department_id": {
      "type": "many2one",
      "label": "Department",
      "relation": "hr.department"
    },
    "multi_employee": {
      "type": "boolean",
      "label": "Several employees",
      "help": "Holds whether this allocation concerns more than 1 employee",
      "readonly": true
    },
    "employee_id": {
      "type": "many2one",
      "label": "Employee",
      "relation": "hr.employee"
    },
    "employee_ids": {
      "type": "many2many",
      "label": "Employees",
      "relation": "hr.employee"
    },
    "employee_company_id": {
      "type": "many2one",
      "label": "Employee Company",
      "relation": "res.company",
      "readonly": true
    },
    "leave_type_increases_duration": {
      "type": "boolean",
      "label": "Whole days only",
      "readonly": true
    },
    "holiday_status_id": {
      "type": "many2one",
      "label": "Time Off Type",
      "relation": "hr.leave.type",
      "required": true,
      "filter": [
        {
          "any": [
            {
              "field": "requires_allocation",
              "op": "=",
              "value": "no"
            },
            {
              "all": [
                {
                  "field": "has_valid_allocation",
                  "op": "=",
                  "value": true
                },
                {
                  "any": [
                    {
                      "field": "allows_negative",
                      "op": "=",
                      "value": true
                    },
                    {
                      "all": [
                        {
                          "field": "virtual_remaining_leaves",
                          "op": ">",
                          "value": 0
                        },
                        {
                          "field": "allows_negative",
                          "op": "=",
                          "value": false
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "date_from": {
      "type": "datetime",
      "label": "Start Date",
      "readonly": true
    },
    "date_to": {
      "type": "datetime",
      "label": "End Date",
      "readonly": true
    },
    "request_date_from": {
      "type": "date",
      "label": "Request Start Date"
    },
    "request_date_to": {
      "type": "date",
      "label": "Request End Date"
    },
    "request_date_from_period": {
      "type": "selection",
