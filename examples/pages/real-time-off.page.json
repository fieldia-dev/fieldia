    "number_of_days_display": {
      "type": "float",
      "label": "Duration in days",
      "help": "Number of days of the time off request according to your working schedule. Used for interface.",
      "readonly": true,
      "digits": [
        6,
        2
      ]
    },
    "number_of_hours_display": {
      "type": "float",
      "label": "Duration in hours",
      "help": "Number of hours of the time off request according to your working schedule. Used for interface.",
      "readonly": true,
      "digits": [
        6,
        2
      ]
    },
    "number_of_hours_text": {
      "type": "char",
      "label": "Duration in hours",
      "readonly": true
    },
    "overtime_deductible": {
      "type": "boolean",
      "label": "Deducted from extra hours",
      "readonly": true
    },
    "employee_overtime": {
      "type": "float",
      "label": "Extra Hours Available",
      "readonly": true,
      "digits": [
        6,
        2
      ]
    },
    "name": {
      "type": "text",
      "label": "Description"
    },
    "user_id": {
      "type": "many2one",
      "label": "User",
      "relation": "res.users",
      "readonly": true
    },
    "leave_type_support_document": {
      "type": "boolean",
      "label": "Supporting Document needed",
      "readonly": true
    },
    "supported_attachment_ids": {
      "type": "binary",
      "label": "Attach File",
      "multiple": true
    },
    "first_approver_id": {
      "type": "many2one",
      "label": "First Approval",
      "help": "This area is automatically filled by the user who validate the time off",
      "relation": "hr.employee",
      "readonly": true
    },
    "second_approver_id": {
      "type": "many2one",
      "label": "Second Approval",
      "help": "This area is automatically filled by the user who validate the time off with second level (If time off type need second validation)",
      "relation": "hr.employee",
      "readonly": true
    },
    "leave_stats": {
      "type": "html",
      "label": "Time off of the employee and the department",
      "readonly": true
    }
  },
  "layout": {
    "type": "sheet",
    "id": "sheet",
    "statusbar": {
      "field": "state",
      "visibleStates": [
        "confirm",
        "validate"
      ],
      "invisible": "not active"
    },
    "ribbon": {
      "id": "ribbon-canceled",
      "label": "Canceled",
      "tone": "danger",
      "invisible": "active"
    },
    "alerts": [
      {
        "id": "tz-employee",
        "tone": "info",
        "message": "The employee has a different timezone than yours! Here dates and times are displayed in the employee's timezone ({tz}).",
        "invisible": "not request_unit_hours or not tz_mismatch or holiday_type == 'category' or holiday_type != 'employee'"
      },
      {
        "id": "tz-department",
        "tone": "info",
        "message": "The department's company has a different timezone than yours! Here dates and times are displayed in the company's timezone ({tz}).",
        "invisible": "not request_unit_hours or not tz_mismatch or holiday_type == 'category' or holiday_type != 'department'"
      },
      {
        "id": "tz-company",
        "tone": "info",
        "message": "The company has a different timezone than yours! Here dates and times are displayed in the company's timezone ({tz}).",
        "invisible": "not request_unit_hours or not tz_mismatch or holiday_type == 'category' or holiday_type != 'company'"
      }
    ],
    "buttons": [
      {
        "type": "button",
        "id": "action_confirm",
        "label": "Confirm",
        "style": "primary",
        "invisible": "not id or state != 'draft' or not active",
        "steps": [
          {
            "do": "set",
            "field": "state",
            "value": "'confirm'"
          },
          {
            "do": "set",
            "when": "validation_type == 'no_validation'",
            "field": "state",
            "value": "'validate'"
          },
          {
            "do": "save"
          },
          {
            "do": "say",
            "when": "state == 'confirm'",
            "message": "Sent to the approver.",
            "tone": "success"
          }
        ]
      },
      {
        "type": "button",
        "id": "action_approve",
        "label": "Approve",
        "style": "primary",
        "invisible": "not active or not can_approve or state != 'confirm'",
        "steps": [
          {
            "do": "set",
            "when": "validation_type == 'both'",
            "field": "state",
            "value": "'validate1'"
          },
          {
            "do": "set",
            "when": "validation_type != 'both'",
            "field": "state",
            "value": "'validate'"
          },
          {
            "do": "call",
            "action": "leave_approved"
          },
          {
            "do": "save"
          }
        ]
      },
      {
        "type": "button",
        "id": "action_validate",
        "label": "Validate",
        "style": "primary",
        "invisible": "state != 'validate1'",
        "steps": [
          {
            "do": "set",
            "field": "state",
            "value": "'validate'"
          },
          {
            "do": "call",
            "action": "leave_approved"
          },
          {
            "do": "save"
          }
        ],
        "roles": [
          "hr_holidays.group_hr_holidays_user"
        ]
      },
      {
        "type": "button",
        "id": "action_refuse",
        "label": "Refuse",
        "invisible": "not active or not can_approve or state not in ('confirm', 'validate1', 'validate')",
        "steps": [
          {
            "do": "call",
            "action": "leave_refused"
          },
          {
            "do": "set",
            "field": "state",
            "value": "'refuse'"
          },
          {
            "do": "save"
          }
        ]
      },
      {
        "type": "button",
        "id": "action_cancel",
        "label": "Cancel",
        "invisible": "not active or not can_cancel",
        "steps": [
          {
            "do": "open",
            "page": "real-time-off-cancel",
            "as": "dialog",
            "title": "Cancel Time Off",
            "then": [
              {
                "do": "call",
                "action": "leave_cancelled"
              },
              {
                "do": "save"
              }
            ]
          }
        ]
      },
      {
        "type": "button",
        "id": "action_draft",
        "label": "Mark as Draft",
        "invisible": "not can_reset or state not in ('confirm', 'refuse')",
        "steps": [
          {
            "do": "set",
            "field": "state",
            "value": "'draft'"
          },
          {
            "do": "clear",
            "field": "first_approver_id"
          },
          {
            "do": "clear",
            "field": "second_approver_id"
          },
          {
            "do": "save"
          }
        ]
      }
    ],
    "children": [
      {
        "type": "section",
        "id": "col_left",
        "style": "plain",
        "columns": {
          "wide": 12,
          "medium": 12
        },
        "children": [
          {
            "type": "field",
            "id": "f-display-name",
            "field": "display_name",
            "labels": "hidden",
            "colspan": 12,
            "invisible": "not holiday_status_id"
          },
          {
            "type": "field",
            "id": "f-mode",
            "field": "holiday_type",
            "label": "Mode",
            "colspan": 12,
            "readonly": "state not in ('confirm', 'draft')",
            "roles": [
              "hr_holidays.group_hr_holidays_user"
            ]
          },
          {
            "type": "field",
            "id": "f-mode-company",
            "field": "mode_company_id",
            "label": "Company",
            "colspan": 12,
            "invisible": "holiday_type != 'company'",
            "readonly": "state not in ('confirm', 'draft')",
            "required": "holiday_type == 'company'",
            "roles": [
              "hr_holidays.group_hr_holidays_user"
            ]
          },
          {
            "type": "field",
            "id": "f-category",
            "field": "category_id",
            "colspan": 12,
            "invisible": "holiday_type != 'category'",
            "readonly": "state not in ('confirm', 'draft')",
            "required": "holiday_type == 'category'",
            "roles": [
              "hr_holidays.group_hr_holidays_user"
            ]
          },
          {
            "type": "field",
            "id": "f-department",
            "field": "department_id",
            "colspan": 12,
            "invisible": "holiday_type != 'department'",
            "readonly": "state in ('cancel', 'refuse', 'validate', 'validate1')",
            "required": "holiday_type == 'department'",
            "roles": [
              "hr_holidays.group_hr_holidays_user"
            ]
          },
          {
            "type": "field",
            "id": "f-employee",
            "field": "employee_id",
            "colspan": 12,
            "invisible": "holiday_type != 'employee' or state != 'validate' or not employee_id",
            "readonly": "state in ('cancel', 'refuse', 'validate', 'validate1')",
            "roles": [
              "hr_holidays.group_hr_holidays_user"
            ],
            "options": {
              "avatar": true
            }
          },
          {
            "type": "field",
            "id": "f-employees",
            "field": "employee_ids",
            "widget": "tags",
            "colspan": 12,
            "invisible": "holiday_type != 'employee' or (state == 'validate' and employee_id)",
            "readonly": "state in ('cancel', 'refuse', 'validate', 'validate1')",
            "required": "holiday_type == 'employee' and state in ('draft', 'cancel', 'refuse')",
            "roles": [
              "hr_holidays.group_hr_holidays_user"
            ],
            "options": {
              "avatar": true
            }
          },
          {
            "type": "field",
            "id": "f-type",
            "field": "holiday_status_id",
            "colspan": 12,
            "options": {
              "create": false
            },
            "readonly": "state in ('cancel', 'refuse', 'validate', 'validate1')"
          },
          {
            "type": "field",
            "id": "f-date",
            "field": "request_date_from",
            "label": "Date",
            "colspan": 8,
            "invisible": "not request_unit_half and not request_unit_hours",
            "readonly": "state not in ('draft', 'confirm')"
          },
          {
            "type": "field",
            "id": "f-period",
            "field": "request_date_from_period",
            "labels": "hidden",
            "colspan": 4,
            "invisible": "not request_unit_half",
            "required": "request_unit_half",
            "readonly": "state not in ('draft', 'confirm')"
          },
          {
            "type": "field",
            "id": "f-dates-from",
            "field": "request_date_from",
            "label": "Dates",
            "colspan": 12,
            "invisible": "request_unit_half or request_unit_hours",
            "readonly": "state not in ('draft', 'confirm')",
            "required": "not date_from or not date_to",
            "widget": "daterange",
            "options": {
              "endField": "request_date_to"
            },
            "validate": [
              {
                "holds": "request_date_to >= request_date_from",
                "message": "The start date must be before or equal to the end date."
              }
            ]
          },
          {
            "type": "field",
            "id": "f-half",
            "field": "request_unit_half",
            "colspan": 6,
            "invisible": "leave_type_request_unit == 'day'",
            "readonly": "state not in ('draft', 'confirm')"
          },
          {
            "type": "field",
            "id": "f-hours",
            "field": "request_unit_hours",
            "colspan": 6,
            "invisible": "leave_type_request_unit != 'hour'",
            "readonly": "state not in ('draft', 'confirm')"
          },
          {
            "type": "field",
            "id": "f-hour-from",
            "field": "request_hour_from",
            "label": "From",
            "colspan": 6,
            "invisible": "not request_unit_hours",
            "readonly": "state == 'validate'",
            "required": "request_unit_hours"
          },
          {
            "type": "field",
            "id": "f-hour-to",
            "field": "request_hour_to",
            "label": "To",
            "colspan": 6,
            "invisible": "not request_unit_hours",
            "readonly": "state == 'validate'",
            "required": "request_unit_hours"
          },
          {
            "type": "field",
            "id": "f-duration-days",
            "field": "number_of_days_display",
            "label": "Duration",
            "colspan": 8,
            "options": {
              "suffix": "Days"
            },
            "invisible": "request_unit_half or request_unit_hours"
          },
          {
            "type": "field",
            "id": "f-duration-hours-beside",
            "field": "number_of_hours_text",
            "labels": "hidden",
            "colspan": 4,
            "invisible": "leave_type_request_unit != 'hour' or request_unit_half or request_unit_hours"
          },
          {
            "type": "field",
            "id": "f-duration-hours",
            "field": "number_of_hours_text",
            "label": "Duration",
            "colspan": 12,
            "invisible": "leave_type_request_unit != 'hour' or not (request_unit_half or request_unit_hours)"
          },
          {
            "type": "field",
            "id": "f-overtime",
            "field": "employee_overtime",
            "colspan": 12,
            "options": {
              "suffix": "hours"
            },
            "invisible": "not employee_id or not overtime_deductible or employee_overtime <= 0",
            "widget": "duration",
            "tones": [
              {
                "tone": "success",
                "when": "employee_overtime > 0"
              }
            ]
          },
          {
            "type": "field",
            "id": "f-name",
            "field": "name",
            "colspan": 12,
            "placeholder": "Add a description..."
          },
          {
            "type": "field",
            "id": "f-document",
            "field": "supported_attachment_ids",
            "label": "Supporting Document",
            "colspan": 12,
            "invisible": "not leave_type_support_document or state not in ('draft', 'confirm', 'validate1')"
          }
        ]
      },
      {
        "type": "section",
        "id": "col_right",
        "style": "plain",
        "children": [
          {
            "type": "field",
            "id": "f-stats",
            "field": "leave_stats",
            "labels": "hidden",
            "options": {
              "toolbar": false
            }
          }
        ]
      },
      {
        "type": "text",
        "id": "duration_warning",
        "style": "alert",
        "text": "You can only take this time off in whole days, so if your schedule has half days, it won't be used efficiently.",
        "invisible": "not leave_type_increases_duration",
        "tone": "warning"
      }
    ],
    "sidePanel": {
      "type": "slot",
      "id": "chatter",
      "name": "chatter"
    },
    "toolbar": {
      "menu": [
        {
          "id": "m-archive",
          "builtin": "archive"
        },
        {
          "id": "m-unarchive",
          "builtin": "unarchive"
        },
        {
          "id": "m-duplicate",
          "builtin": "duplicate"
        },
        {
          "id": "m-delete",
          "builtin": "delete"
        }
      ],
      "pager": true,
      "breadcrumbs": true
    },
    "attachmentPreview": {}
  }
}
