      "Name": "الاسم",
      "Phone": "الهاتف",
      "Address": "العنوان",
      "Type the street: pick a suggestion, or keep what you typed.": "اكتب الشارع: اختر اقتراحًا، أو احتفظ بما كتبت.",
      "Address in parts": "العنوان مفصّلًا",
      "On the map": "على الخريطة",
      "Who": "مَن",
      "Where": "أين"
    }
  }
}
